---
import Footer from "../../components/v2.1/layout/home/Footer.astro";
import Header from "../../components/v2.1/layout/home/Header.astro";
import "../../styles/v2.1/global.css";

interface Props {
  title?: string;
}

const { title = "Portfolio v2" } = Astro.props;
---

<!doctype html>
<html
  lang="ko"
  data-theme="light"
  class="scroll-smooth motion-reduce:scroll-auto"
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body
    id="top"
    class="min-h-screen min-w-80 bg-base-100 text-base-content antialiased"
  >
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
