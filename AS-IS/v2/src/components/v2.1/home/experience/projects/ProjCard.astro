---
import { FileText } from "@lucide/astro";
import type {
ProjectEntry,
ProjectSummary,
Task,
} from "../../../../../content/v2.1/collections/projects";
import SkillItem from "../../../SkillItem.astro";
import ReadmeModal from "../readme/ReadmeModal.astro";

interface Props {
  project: ProjectSummary;
  entry: ProjectEntry;
}

const { project, entry } = Astro.props;
const readmeModalId = `readme-${project.id.replaceAll("/", "-")}`;
const hasDocument = Boolean(entry.body?.trim());
const visibleSkills = project.stack?.slice(0, 3) ?? [];
const hasHiddenSkills = (project.stack?.length ?? 0) > visibleSkills.length;

function getTaskTitle(task: Task): string {
  return typeof task === "string" ? task : task.title;
}
---

<article
  class:list={[
    "relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white transition-colors duration-200 motion-reduce:transition-none",
    hasDocument && "group/project-card cursor-pointer hover:border-slate-400",
  ]}
>
  {
    hasDocument && (
      <button
        type="button"
        class="absolute inset-0 z-10 cursor-pointer rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-inset"
        data-readme-open={readmeModalId}
        aria-label={`${project.title} README 보기`}
      >
        <span class="sr-only">{project.title} README 보기</span>
      </button>
    )
  }

  <div class="flex flex-1 flex-col px-4 py-1.5 sm:px-5 sm:py-2">
    <header class="min-w-0">
      <h3
        class="text-sm font-bold tracking-[-0.03em] text-slate-950 sm:text-base"
      >
        {project.title}
      </h3>
      <time
        class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-[0.06em] text-slate-500"
      >
        {project.period}
      </time>
    </header>

    <div
      class="my-2 h-px bg-gradient-to-r from-slate-300 via-slate-200 to-transparent"
      aria-hidden="true"
    >
    </div>
    <ul class="space-y-1.5">
      {
        project.highlights.slice(0, 3).map((highlight) => (
          <li class="flex items-start gap-2 text-xs leading-4 font-medium text-slate-900">
            <span
              class="mt-2 size-1 shrink-0 rounded-full bg-slate-400"
              aria-hidden="true"
            />
            <span>{getTaskTitle(highlight)}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-auto flex flex-nowrap items-center justify-between gap-3">
      {
        visibleSkills.length > 0 && (
          <div class="inline-flex shrink-0 px-2 py-1.5">
            <ul
              class="flex max-w-full flex-nowrap gap-1.5 [&>li]:shrink-0"
              aria-label={`${project.title} 기술 스택`}
            >
              {visibleSkills.map((skill) => (
                <SkillItem name={skill} showName={false} compact />
              ))}
              {hasHiddenSkills && (
                <li
                  class="px-0.5 py-0.5 text-xs font-semibold text-slate-500"
                  aria-label="기술 스택 더 있음"
                >
                  …
                </li>
              )}
            </ul>
          </div>
        )
      }
      {
        hasDocument && (
          <span
            class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-600 shadow-sm transition-colors duration-200 group-hover/project-card:border-slate-950 group-hover/project-card:bg-slate-950 group-hover/project-card:text-white motion-reduce:transition-none"
            aria-hidden="true"
          >
            <FileText class="size-3.5" stroke-width={2} />
          </span>
        )
      }
    </div>
  </div>
</article>

{hasDocument && <ReadmeModal modalId={readmeModalId} project={entry} />}
