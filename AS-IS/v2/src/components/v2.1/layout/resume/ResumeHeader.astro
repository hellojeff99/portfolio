---
import { FileText } from "@lucide/astro";
import ResumePortfolioBtn from "../ResumePortfolioBtn.astro";
---

<header
  class="group/header sticky inset-x-0 top-0 z-50 border-b border-slate-200 bg-white font-sans shadow-sm"
>
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8 lg:px-12"
  >
    <a
      class="group/brand inline-flex min-w-0 items-center gap-3 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2"
      href="/resume"
      aria-label="Jeffrey's resume 최상단으로 이동"
    >
      <span
        class="grid size-8 shrink-0 place-items-center rounded-full bg-slate-950 text-sm font-bold tracking-tighter text-white transition duration-300 ease-out group-hover/brand:-rotate-6 motion-reduce:transition-none"
        aria-hidden="true"
      >
        <FileText class="size-4" stroke-width={2.4} aria-hidden="true" />
      </span>
      <span class="truncate text-lg font-bold tracking-tight text-slate-950">
        JEFFREY'S RESUME
      </span>
    </a>

    <div class="ml-auto flex items-center gap-3">

      <ResumePortfolioBtn
        page="portfolio"
        class="hidden h-10 cursor-pointer items-center gap-2 rounded-full border border-slate-950 bg-slate-950 px-3.5 text-sm font-bold tracking-[0.12em] text-white shadow-sm shadow-slate-950/15 transition-[background-color,border-color,box-shadow,color,transform] duration-300 ease-out hover:-translate-y-1 hover:border-sky-400 hover:bg-sky-400 hover:text-slate-950 hover:shadow-lg hover:shadow-sky-400/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 motion-reduce:transition-none sm:inline-flex"
      />
    </div>
  </div>
</header>
