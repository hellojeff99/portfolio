---
import type {
ProjectEntry,
Task,
} from "../../../../content/v2.1/collections/projects";
import BulletText from "../common/BulletText.astro";
import SkillLabel from "../common/SkillLabel.astro";
import TextLabel from "../common/TextLabel.astro";

interface Props {
  career: ProjectEntry;
}

const { career } = Astro.props;
const { data } = career;

function getTaskTitle(task: Task): string {
  return typeof task === "string" ? task : task.title;
}

function getSubtasks(task: Task): string[] {
  return typeof task === "string" ? [] : (task.subtasks ?? []);
}
---

<article class="break-inside-avoid">
  <header
    class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-x-8"
  >
    <div class="min-w-0">
      <h3 class="m-0 text-sm font-bold tracking-tight text-slate-950">
        {data.title}
      </h3>
      <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 leading-4">
        {
          data.subtitle && (
            <p class="m-0 text-xs font-semibold text-slate-700">
              {data.subtitle}
            </p>
          )
        }
        {
          data.subtitle && data.meta && (
            <span class="text-xs font-normal text-slate-300">·</span>
          )
        }
        {
          data.meta && (
            <p class="m-0 text-xs font-medium text-slate-500">{data.meta}</p>
          )
        }
      </div>
    </div>
    <div class="w-fit shrink-0 whitespace-nowrap">
      <TextLabel text={data.period} />
    </div>
  </header>

  <ul class="mt-2 grid gap-1">
    {
      data.contributions.map((contribution: Task) => (
        <BulletText text={getTaskTitle(contribution)}>
          {getSubtasks(contribution).length > 0 && (
            <ul class="mt-1.5 grid gap-1 pl-3 text-xs font-normal leading-relaxed text-slate-500">
              {getSubtasks(contribution).map((subtask) => (
                <li class="before:mr-2 before:content-['–']">{subtask}</li>
              ))}
            </ul>
          )}
        </BulletText>
      ))
    }
  </ul>

  {
    data.stack && data.stack.length > 0 && (
      <ul class="mt-2 flex flex-wrap gap-1.5">
        {data.stack.map((skill) => (
          <SkillLabel {skill} />
        ))}
      </ul>
    )
  }
</article>
