---
import { getCollection } from "astro:content";
import {
compareProjectIds,
type ProjectEntry,
} from "../../../../content/v2.1/collections/projects";
import Divider from "../common/Divider.astro";
import SectionLayout from "../common/section/SectionLayout.astro";
import CareerEntry from "./CareerEntry.astro";

const careerEntries: ProjectEntry[] = (await getCollection("v2Projects"))
  .filter((entry) => entry.id.startsWith("career/"))
  .sort((first, second) => compareProjectIds(first.id, second.id));
---

<SectionLayout title="Career" id="career">
  <div class="grid">
    {
      careerEntries.map((career, index) => (
        <div class="break-inside-avoid pt-2 first:pt-0">
          <CareerEntry {career} />
          {index < careerEntries.length - 1 && <Divider />}
        </div>
      ))
    }
  </div>
</SectionLayout>
