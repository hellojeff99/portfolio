---
import type {
ProjectEntry,
Task,
} from "../../../../content/v2.1/collections/projects";
import BulletText from "../common/BulletText.astro";
import SkillLabel from "../common/SkillLabel.astro";
import TextLabel from "../common/TextLabel.astro";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;

function getTaskTitle(task: Task): string {
  return typeof task === "string" ? task : task.title;
}
---

<article class="break-inside-avoid">
  <header
    class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-x-8"
  >
    <div class="min-w-0">
      <h3 class="m-0 text-sm font-bold tracking-tight text-slate-950">
        {data.title}
      </h3>
      {
        data.subtitle && (
          <p class="mt-1 text-xs leading-4 font-normal text-slate-600">
            {data.subtitle}
          </p>
        )
      }
    </div>

    <div class="flex flex-wrap items-center gap-2 sm:justify-end">
      {data.type && <TextLabel text={data.type} />}
      <TextLabel text={data.period} />
    </div>
  </header>

  <ul class="mt-2 grid gap-1" aria-label={`${data.title} 기여 내용`}>
    {
      data.contributions.map((contribution: Task) => (
        <BulletText text={getTaskTitle(contribution)} />
      ))
    }
  </ul>

  {
    data.stack && data.stack.length > 0 && (
      <ul
        class="mt-2 flex flex-wrap gap-1.5"
        aria-label={`${data.title} 기술 스택`}
      >
        {data.stack.map((stack: string) => (
          <SkillLabel skill={stack} />
        ))}
      </ul>
    )
  }
</article>
