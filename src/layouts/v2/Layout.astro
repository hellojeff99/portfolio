---
import Footer from "../../components/v2/layout/Footer.astro";
import Header from "../../components/v2/layout/Header.astro";
import "../../styles/v2/global.css";

interface Props {
  title?: string;
}

const { title = "Portfolio v2" } = Astro.props;
const isDevelopment = import.meta.env.DEV;
---

<!doctype html>
<html
  lang="ko"
  data-theme="light"
  class="scroll-smooth motion-reduce:scroll-auto"
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body
    id="top"
    class:list={[
      "min-h-screen min-w-80 bg-base-100 font-sans text-base-content antialiased",
      isDevelopment && "border-sky-700 border-2 border-dashed",
    ]}
  >
    <Header />
    <main
      class:list={[isDevelopment && "border-sky-700 border-y-2 border-dashed"]}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
