---
import ResumeHeader from "../../components/v2/layout/resume/ResumeHeader.astro";
import ResumeFooter from "../../components/v2/layout/resume/ResumeFooter.astro";
import "../../styles/v2/global.css";

interface Props {
  title?: string;
}

const { title = "Jeffrey's Resume" } = Astro.props;
---

<!doctype html>
<html
  lang="ko"
  data-theme="light"
  class="scroll-smooth motion-reduce:scroll-auto print:[-webkit-print-color-adjust:exact] print:[print-color-adjust:exact]"
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body
    id="top"
    class="min-h-screen min-w-80 bg-base-100 text-base-content antialiased print:min-w-0 print:bg-white"
  >
    <ResumeHeader />
    <main
      class="overflow-x-auto bg-slate-100 pb-[10mm] pt-16 print:overflow-visible print:bg-white print:p-0 print:[orphans:3] print:[widows:3]"
    >
      <div
        class="font-noto-sans-kr mx-auto mt-[10mm] min-h-[210mm] w-[270mm] border border-slate-200 bg-white py-8 shadow-sm print:mt-0 print:min-h-0 print:w-[90%] print:border-0 print:py-4 print:shadow-none print:[zoom:90%]"
        data-resume-sheet
      >
        <slot />
      </div>
    </main>
    <ResumeFooter />
  </body>
</html>

<style is:global>
  @page {
    size: A4 portrait;
    margin: 5mm 0;
  }
</style>
