---
import { getEntry } from "astro:content";
import BulletText from "./common/BulletText.astro";
import SectionLayout from "./common/section/SectionLayout.astro";

const resumeEntry = await getEntry("v2Resume", "resume");

if (!resumeEntry) {
  throw new Error("v2 Resume About에 필요한 이력서 데이터를 찾을 수 없습니다.");
}

function normalizeBio(bio: string[] | string): string[] {
  return Array.isArray(bio)
    ? bio
    : bio.split("\n").filter((sentence) => sentence.length > 0);
}

const bioSentences = normalizeBio(resumeEntry.data.info.bio);
---

<SectionLayout title="About" id="about">
  <ul class="grid gap-1" aria-label="소개">
    {bioSentences.map((sentence) => <BulletText text={sentence} />)}
  </ul>
</SectionLayout>
