---
interface Props {
  label: string;
  value: string;
  accent: "blue" | "emerald" | "amber";
  href?: string;
  breakAll?: boolean;
}

const { label, value, accent, href, breakAll = false } = Astro.props;
const accentClass = {
  blue: "bg-blue-600",
  emerald: "bg-emerald-600",
  amber: "bg-amber-500",
}[accent];
---

<div
  class="min-w-0 overflow-hidden rounded-lg border border-slate-100 bg-white shadow-lg shadow-blue-950/10"
>
  <dt
    class="font-mono flex items-center gap-2 border-b border-slate-200 bg-slate-100 px-3 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-700"
  >
    <span
      class:list={["size-1.5 shrink-0 rounded-full", accentClass]}
      aria-hidden="true"></span>
    <span>{label}</span>
  </dt>
  <dd
    class:list={[
      "px-3 py-2.5 font-mono text-[0.9rem] font-bold leading-relaxed",
      breakAll ? "min-w-0" : "break-words text-slate-900",
    ]}
  >
    {
      href ? (
        <a
          class:list={[
            "text-slate-900 transition-colors hover:text-blue-600",
            breakAll ? "min-w-0 break-all" : "break-words",
          ]}
          href={href}
        >
          {value}
        </a>
      ) : (
        <span>{value}</span>
      )
    }
  </dd>
</div>
