---
import SkillItem from "../SkillItem.astro";

interface Props {
  items?: string[];
  projectTitle: string;
  compact?: boolean;
  class?: string;
}

const { items, projectTitle, compact = false, class: className } = Astro.props;
const visibleItems = items?.slice(0, 5) ?? [];
const hiddenItemCount = Math.max((items?.length ?? 0) - visibleItems.length, 0);
---

{
  items && items.length > 0 && (
    <div
      class:list={[
        "flex min-w-0 max-w-full items-center overflow-hidden",
        className,
      ]}
      role="group"
      aria-label={`${projectTitle} 기술 스택`}
    >
      <ul
        class:list={[
          "flex min-w-0 list-none flex-nowrap overflow-hidden p-0",
          compact ? "gap-1.5" : "gap-2",
        ]}
      >
        {visibleItems.map((item) => (
          <SkillItem name={item} large={compact} />
        ))}
      </ul>
      {hiddenItemCount > 0 && (
        <span
          class:list={[
            "shrink-0 font-mono text-sm font-bold text-slate-500",
            compact ? "ml-1.5" : "ml-2",
          ]}
          aria-label={`${hiddenItemCount}개 기술 스택 더 있음`}
        >
          ...
        </span>
      )}
    </div>
  )
}
