---
import { ArrowUp, Mail } from "@lucide/astro";

interface Props {
  name: string;
  email: string;
}

const { name, email } = Astro.props;
---

<footer class="px-3 py-4 sm:px-4 lg:px-6" aria-label="페이지 하단">
  <div
    class="flex flex-col gap-3 border-t border-slate-200 pt-4 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="m-0 font-mono">© {new Date().getFullYear()} {name}</p>
    <div class="flex flex-wrap items-center gap-1">
      <a
        class="inline-flex min-h-10 items-center gap-2 rounded-lg bg-blue-600 px-3 font-semibold text-white shadow-sm shadow-blue-600/20 transition-colors hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
        href={`mailto:${email}`}
        aria-label={`${email}로 이메일 보내기`}
      >
        <Mail size={15} stroke-width={2} aria-hidden="true" />
        <span>Send Email</span>
      </a>
      <a
        class="group inline-flex min-h-10 items-center gap-2 rounded-lg px-3 font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
        href="#top"
        aria-label="페이지 최상단으로 이동"
      >
        <span>Back to top</span>
        <ArrowUp
          class="transition-transform duration-200 group-hover:-translate-y-0.5 motion-reduce:transform-none"
          size={15}
          stroke-width={2}
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</footer>
