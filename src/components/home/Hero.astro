---
import { Code2 } from "@lucide/astro";

interface Props {
  role: string;
  email: string;
  location: string;
  summary: string;
  summaryHighlight?: string;
}

const { role, email, location, summary, summaryHighlight } = Astro.props;
const highlightStart = summaryHighlight
  ? summary.indexOf(summaryHighlight)
  : -1;
const summarySegments =
  summaryHighlight && highlightStart >= 0
    ? [
        { text: summary.slice(0, highlightStart), highlighted: false },
        { text: summaryHighlight, highlighted: true },
        {
          text: summary.slice(highlightStart + summaryHighlight.length),
          highlighted: false,
        },
      ]
    : [{ text: summary, highlighted: false }];
---

<section
  id="hero"
  class="hero-section-background relative isolate flex scroll-mt-24 items-center"
  data-nav-section
  aria-labelledby="hero-title"
>
  <div
    class="ml-2 flex min-h-[62svh] min-w-0 flex-1 flex-col md:ml-4 lg:h-[62svh] lg:min-h-0"
  >
    <div class="min-h-0 min-w-0 flex-1">
      <div
        class="relative isolate grid h-full min-h-0 min-w-0 gap-4 overflow-hidden px-3 sm:px-4 lg:grid-cols-3 lg:gap-x-5 lg:overflow-y-auto lg:px-5 xl:px-6"
      >
        <div
          class="relative z-10 flex min-w-0 flex-col gap-4 lg:col-span-2 pt-20"
        >
          <dl
            class="grid w-full shrink-0 gap-1.5 sm:grid-cols-3"
            aria-label="프로필 정보"
          >
            <div
              class="min-w-0 overflow-hidden rounded-lg border border-slate-100 bg-white shadow-lg shadow-blue-950/10"
            >
              <dt
                class="font-mono flex items-center gap-2 border-b border-slate-200 bg-slate-100 px-3 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-700"
              >
                <span
                  class="size-1.5 shrink-0 rounded-full bg-blue-600"
                  aria-hidden="true"></span>
                <span>Name</span>
              </dt>
              <dd
                class="break-words px-3 py-2.5 font-mono text-[0.9rem] font-bold leading-relaxed text-slate-900"
              >
                <span>양성원</span>
              </dd>
            </div>

            <div
              class="min-w-0 overflow-hidden rounded-lg border border-slate-100 bg-white shadow-lg shadow-blue-950/10"
            >
              <dt
                class="font-mono flex items-center gap-2 border-b border-slate-200 bg-slate-100 px-3 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-700"
              >
                <span
                  class="size-1.5 shrink-0 rounded-full bg-emerald-600"
                  aria-hidden="true"></span>
                <span>Location</span>
              </dt>
              <dd
                class="break-words px-3 py-2.5 font-mono text-[0.9rem] font-bold leading-relaxed text-slate-900"
              >
                <span>{location}</span>
              </dd>
            </div>

            <div
              class="min-w-0 overflow-hidden rounded-lg border border-slate-100 bg-white shadow-lg shadow-blue-950/10"
            >
              <dt
                class="font-mono flex items-center gap-2 border-b border-slate-200 bg-slate-100 px-3 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-slate-700"
              >
                <span
                  class="size-1.5 shrink-0 rounded-full bg-amber-500"
                  aria-hidden="true"></span>
                <span>Email</span>
              </dt>
              <dd
                class="min-w-0 px-3 py-2.5 font-mono text-[0.9rem] font-bold leading-relaxed"
              >
                <a
                  class="min-w-0 break-all text-slate-900 transition-colors hover:text-blue-600"
                  href={`mailto:${email}`}
                >
                  {email}
                </a>
              </dd>
            </div>
          </dl>

          <div class="w-full max-w-4xl border-l-2 border-white/40 pl-3 sm:pl-4">
            <p
              class="hero-label-enter font-mono mb-3 inline-flex w-fit items-center gap-2 rounded-full border border-white/30 bg-black/20 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-white shadow-sm"
            >
              <span class="size-1.5 rounded-full bg-cyan-200" aria-hidden="true"
              ></span>
              <span>{role}</span>
            </p>

            <h1
              class="hero-title-readable relative m-0 break-keep text-3xl font-bold leading-[1.28] tracking-tighter text-white sm:text-4xl md:text-5xl xl:text-[3.5rem]"
              id="hero-title"
              data-hero-typing
              aria-label={summary}
            >
              <span class="invisible block" aria-hidden="true">
                {summary}
              </span>
              <span class="absolute inset-0 block" aria-hidden="true">
                {
                  summarySegments.map(({ text, highlighted }) => (
                    <span
                      class:list={{ "text-yellow-300": highlighted }}
                      data-type-segment
                      data-text={text}
                    >
                      {text}
                    </span>
                  ))
                }
                <span
                  class="hero-type-caret ml-1 h-[0.9em] w-[0.08em] bg-yellow-300 align-[-0.05em]"
                  data-type-caret
                  aria-hidden="true"></span>
              </span>
            </h1>
          </div>
        </div>

        <div
          class="relative z-10 hidden items-center justify-center lg:col-start-3 lg:row-start-1 lg:flex"
          aria-hidden="true"
        >
          <div
            class="relative grid size-56 place-items-center rounded-full border border-white/30 shadow-[0_0_3rem_rgba(15,23,42,0.2)]"
          >
            <span
              class="absolute inset-3 rounded-full border border-dashed border-white/25"
            ></span>
            <span
              class="absolute inset-7 rounded-full border border-white/20 bg-black/10"
            ></span>
            <div class="hero-orbit absolute inset-0">
              <span
                class="absolute left-1/2 top-[-0.3rem] size-2 -translate-x-1/2 rounded-full bg-blue-400 shadow-[0_0_0.75rem_rgba(96,165,250,0.8)]"
              ></span>
              <span
                class="absolute right-[-0.2rem] top-1/2 size-1.5 -translate-y-1/2 rounded-full bg-emerald-400"
              ></span>
              <span
                class="absolute bottom-[-0.2rem] left-1/2 size-1.5 -translate-x-1/2 rounded-full bg-amber-400"
              ></span>
            </div>
            <Code2
              class="relative text-white/90"
              size={44}
              stroke-width={1.5}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section-background::before,
  .hero-section-background::after {
    position: absolute;
    z-index: -1;
    left: -1rem;
    right: -1rem;
    content: "";
    pointer-events: none;
  }

  .hero-section-background::before {
    z-index: -2;
    inset-block: 0;
    background: var(--color-blue-600);
  }

  .hero-section-background::after {
    z-index: -1;
    bottom: 0;
    height: 27rem;
    background: linear-gradient(to bottom, var(--color-blue-600), #f8fafc);
  }

  @media (min-width: 48rem) {
    .hero-section-background::before,
    .hero-section-background::after {
      right: -1.5rem;
      left: 0;
    }

    :global([data-content-layout][data-sidebar-open="false"])
      .hero-section-background::before,
    :global([data-content-layout][data-sidebar-open="false"])
      .hero-section-background::after {
      left: -1.5rem;
    }
  }

  .hero-title-readable {
    text-shadow: 0 0.125rem 1rem rgb(15 23 42 / 0.28);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-label-enter {
      animation: hero-label-reveal 1100ms ease-out both;
    }

    [data-hero-typing][data-typing-active="true"] .hero-type-caret {
      display: inline-block;
      animation: hero-caret-blink 850ms steps(1, end) infinite;
    }

    .hero-orbit {
      animation: hero-orbit 18s linear infinite;
    }
  }

  .hero-type-caret {
    display: none;
  }

  @keyframes hero-label-reveal {
    from {
      opacity: 0;
      letter-spacing: 0.32em;
    }

    to {
      opacity: 1;
      letter-spacing: 0.16em;
    }
  }

  @keyframes hero-caret-blink {
    0%,
    45% {
      opacity: 1;
    }

    46%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-orbit {
    to {
      transform: rotate(1turn);
    }
  }
</style>

<script>
  const initializeHeroTyping = () => {
    document
      .querySelectorAll<HTMLElement>("[data-hero-typing]")
      .forEach((headline) => {
        if (
          headline.dataset.typingInitialized === "true" ||
          window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          return;
        }

        const segments = Array.from(
          headline.querySelectorAll<HTMLElement>("[data-type-segment]"),
        );

        if (segments.length === 0) return;

        headline.dataset.typingInitialized = "true";
        headline.dataset.typingActive = "true";

        const texts = segments.map(
          (segment) => segment.dataset.text ?? segment.textContent ?? "",
        );

        segments.forEach((segment) => {
          segment.textContent = "";
        });

        let segmentIndex = 0;
        let characterIndex = 0;

        const typeNextCharacter = () => {
          const segment = segments[segmentIndex];
          const text = texts[segmentIndex];

          if (!segment || text === undefined) return;

          const characters = Array.from(text);
          const character = characters[characterIndex] ?? "";
          segment.textContent += character;
          characterIndex += 1;

          if (characterIndex >= characters.length) {
            segmentIndex += 1;
            characterIndex = 0;

            if (segmentIndex >= segments.length) return;

            window.setTimeout(typeNextCharacter, 90);
            return;
          }

          const delay = /[,.·]/.test(character) ? 120 : 36;
          window.setTimeout(typeNextCharacter, delay);
        };

        window.setTimeout(typeNextCharacter, 140);
      });
  };

  document.addEventListener("astro:page-load", initializeHeroTyping);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeHeroTyping, {
      once: true,
    });
  } else {
    initializeHeroTyping();
  }
</script>
