---
import {
  BriefcaseBusiness,
  Code2,
  Link2,
  Mail,
  UserRound,
} from "@lucide/astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
  icon?: "about" | "skills" | "experience" | "links" | "contact";
}

const { eyebrow, title, description, id, icon } = Astro.props;
const icons = {
  about: UserRound,
  skills: Code2,
  experience: BriefcaseBusiness,
  links: Link2,
  contact: Mail,
};
const Icon = icon && icons[icon];
---

<header class="mx-auto max-w-3xl text-center font-bold">
  {
    eyebrow && (
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-slate-800/35" aria-hidden="true" />
        <p class="rounded-full border border-slate-800/15 bg-slate-800/5 px-3 py-1 text-xs uppercase tracking-[0.18em] text-slate-800">
          {eyebrow}
        </p>
        <span class="h-px w-8 bg-slate-800/35" aria-hidden="true" />
      </div>
    )
  }
  <div
    class:list={["flex items-center justify-center gap-3", eyebrow && "mt-5"]}
  >
    {
      Icon && (
        <span class="inline-grid size-11 shrink-0 place-items-center rounded-2xl text-slate-800 sm:size-12">
          <Icon
            class="size-12 sm:size-12"
            stroke-width={2.6}
            aria-hidden="true"
          />
        </span>
      )
    }
    <h2
      class="text-4xl uppercase tracking-[-0.04em] text-base-content sm:text-5xl"
      id={id}
    >
      {title}
    </h2>
  </div>
  <div class="mt-6 flex items-center justify-center gap-2" aria-hidden="true">
    <span class="h-1.5 w-1.5 rounded-full bg-slate-800"></span>
    <span class="h-px w-12 bg-slate-800/45"></span>
    <span class="h-1.5 w-1.5 rounded-full bg-slate-800"></span>
  </div>
  {
    description && (
      <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-base-content/65 sm:text-lg">
        {description}
      </p>
    )
  }
</header>
