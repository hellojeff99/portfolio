---
interface Props {
  id?: string;
  tone?: 'default' | 'muted';
  class?: string;
}

const { id, tone = 'default', class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-20 px-4 py-10 sm:px-8 sm:py-12 lg:px-12 lg:py-14',
    tone === 'muted' && 'bg-base-200/50',
    className,
  ]}>
  <div class="mx-auto w-full max-w-7xl">
    <slot />
  </div>
</section>
