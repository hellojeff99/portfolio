---
interface Props {
  id?: string;
  tone?: 'default' | 'muted';
  class?: string;
}

const { id, tone = 'default', class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-20 px-5 py-4 sm:px-8 sm:py-5 lg:px-12 lg:py-6',
    tone === 'muted' && 'bg-base-200/50',
    className,
  ]}>
  <div class="mx-auto w-full max-w-7xl py-4">
    <slot />
  </div>
</section>
