---
import { FileText, X } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  modalId: string;
  project: CollectionEntry<"projects" | "career">;
}

const { modalId, project } = Astro.props;
const projectTitle = project.data.title;
const documentLabel = project.id.startsWith("career/")
  ? "CAREER DOCUMENT"
  : project.id.startsWith("project/featured/")
    ? "FEATURED PROJECT"
    : "PROJECT DOCUMENT";
---

<header class="shrink-0">
  <div
    class="flex items-center justify-between gap-3 border-b border-slate-200 bg-white px-4 py-2 sm:px-5"
  >
    <div class="flex min-w-0 items-center gap-2.5">
      <span
        class="grid size-8 shrink-0 place-items-center rounded-lg bg-blue-50 text-blue-700 ring-1 ring-blue-100"
        aria-hidden="true"
      >
        <FileText class="size-4" stroke-width={1.8} />
      </span>
      <div class="min-w-0">
        <p
          class="truncate text-xs font-bold tracking-[0.1em] text-blue-600 uppercase"
        >
          {documentLabel}
        </p>
        <h2
          id={`${modalId}-title`}
          class="truncate text-sm font-bold tracking-[-0.025em] text-slate-950 sm:text-base"
        >
          {projectTitle}
        </h2>
      </div>
    </div>
    <form method="dialog" class="shrink-0">
      <button
        type="submit"
        class="btn btn-square btn-ghost btn-sm text-slate-500 hover:bg-slate-100 hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
        aria-label={`${projectTitle} 문서 닫기`}
      >
        <X class="size-4" aria-hidden="true" />
      </button>
    </form>
  </div>
</header>
