---
import { Pin } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import SkillItem from '../../../SkillItem.astro';
import HL from '../HL.astro';
import ReadmeBtn from '../readme/ReadmeBtn.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const visibleSkills = entry.data.stack?.slice(0, 5) ?? [];
const hasHiddenSkills = (entry.data.stack?.length ?? 0) > visibleSkills.length;
const hasDoc = Boolean(entry.body);
---

<article
  class:list={[
    'flex h-[300px] min-h-0 flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white px-4 py-4 sm:px-5',
  ]}>
  <header class="shrink-0">
    <div class="flex items-center justify-between gap-3">
      <h3
        class="flex min-w-0 items-center gap-1.5 text-lg font-bold tracking-[-0.03em] text-slate-950 sm:text-xl">
        <Pin
          class="shrink-0 text-blue-700"
          size={19}
          stroke-width={2.5}
          fill="currentColor"
          aria-hidden="true"
        />

        <span class="min-w-0 break-keep">{entry.data.title}</span>
      </h3>

      <time
        class="shrink-0 text-xs font-semibold tracking-[0.04em] text-slate-600">
        {entry.data.period}
      </time>
    </div>

    {
      entry.data.subtitle && (
        <p class="text-xs leading-5 font-medium text-slate-600 sm:text-sm">
          {entry.data.subtitle}
        </p>
      )
    }
  </header>

  <hr
    class="my-4 h-px shrink-0 border-0 bg-gradient-to-r from-slate-300 via-slate-200 to-transparent"
  />

  <div
    class="min-h-0 flex-1 overflow-y-auto overscroll-contain pr-2"
    data-project-card-scroll>
    <ul class="space-y-3" aria-label="주요 성과">
      {entry.data.highlights.map((highlight) => <HL highlight={highlight} />)}
    </ul>
  </div>
  <!-- Bottom -->
  <footer class="mt-auto flex items-end justify-between gap-4 pt-6">
    {
      visibleSkills.length > 0 && (
        <ul
          class="flex max-w-full shrink-0 flex-nowrap gap-1.5 pt-3 [&>li]:shrink-0"
          aria-label={`${entry.data.title} 기술 스택`}>
          {visibleSkills.map((skill) => (
            <SkillItem name={skill} showName={false} />
          ))}

          {hasHiddenSkills && (
            <li
              class="px-0.5 py-0.5 text-xs font-semibold text-slate-500"
              aria-label="기술 스택 더 있음">
              …
            </li>
          )}
        </ul>
      )
    }
    {hasDoc && <ReadmeBtn entry={entry} />}
  </footer>
</article>
