---
import { Pin } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { hasDemoImages } from '../../../../content/collections/experience.ts';
import SkillItem from '../../../SkillItem.astro';
import HL from '../HL.astro';
import DemoBtn from '../common/demo/DemoBtn.astro';
import ReadmeBtn from '../common/readme/ReadmeBtn.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;

const visibleSkills = entry.data.stack?.slice(0, 5) ?? [];
const hasHiddenSkills = (entry.data.stack?.length ?? 0) > visibleSkills.length;

const hasDoc = Boolean(entry.body);
const hasDemo = hasDemoImages(entry);
---

<article
  class="grid min-h-0 grid-rows-[auto_auto_auto_minmax(0,1fr)_auto] overflow-hidden rounded-2xl bg-white px-4 py-4 shadow-sm shadow-slate-900/5 ring-1 ring-slate-900/5 sm:px-5 md:h-80">
  <!-- Header -->
  <header class="min-w-0">
    <div class="flex min-w-0 items-start justify-between gap-3">
      <h3
        class="flex min-w-0 items-center gap-1.5 text-lg font-bold tracking-[-0.03em] text-slate-950 sm:text-xl">
        <Pin
          class="shrink-0 text-blue-700"
          size={19}
          stroke-width={2.5}
          fill="currentColor"
          aria-hidden="true"
        />

        <span class="min-w-0 break-keep">
          {entry.data.title}
        </span>
      </h3>

      <time
        class="shrink-0 pt-1 text-xs font-semibold tracking-[0.04em] text-slate-600">
        {entry.data.period}
      </time>
    </div>

    {
      entry.data.subtitle && (
        <p class="mt-1 text-xs leading-5 font-medium text-slate-600 sm:text-sm">
          {entry.data.subtitle}
        </p>
      )
    }
  </header>

  <!-- Skills -->
  {
    visibleSkills.length > 0 && (
      <ul
        class="mt-2 flex min-w-0 max-w-full flex-nowrap items-center gap-1.5 overflow-hidden [&>li]:shrink-0"
        aria-label={`${entry.data.title} 기술 스택`}>
        {visibleSkills.map((skill) => (
          <SkillItem name={skill} showName={false} />
        ))}

        {hasHiddenSkills && (
          <li
            class="px-0.5 py-0.5 text-xs font-semibold text-slate-500"
            aria-label="기술 스택 더 있음">
            …
          </li>
        )}
      </ul>
    )
  }

  <!-- Divider -->
  <div class="py-3">
    <hr
      class="h-px border-0 bg-linear-to-r from-slate-300 via-slate-200 to-transparent"
    />
  </div>

  <!-- Content -->
  <div
    class="min-h-0 pr-1 md:overflow-y-auto md:overscroll-contain md:pr-2"
    data-project-card-scroll>
    <ul class="space-y-3" aria-label="주요 성과">
      {entry.data.highlights.map((highlight) => <HL highlight={highlight} />)}
    </ul>
  </div>

  <!-- Footer -->
  <footer class="mt-3 flex w-full shrink-0 items-center justify-end gap-2">
    {hasDemo && <DemoBtn entry={entry} />}
    {hasDoc && <ReadmeBtn entry={entry} />}
  </footer>
</article>
