---
import type { CollectionEntry } from 'astro:content';
import SkillItem from '../../../SkillItem.astro';
import HL from '../HL.astro';
import ReadmeBtn from '../common/readme/ReadmeBtn.astro';
import DemoBtn from '../common/demo/DemoBtn.astro';
import { hasDemoImages } from '../../../../content/collections/experience';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;

const visibleSkills = entry.data.stack?.slice(0, 3) ?? [];
const hasHiddenSkills = (entry.data.stack?.length ?? 0) > visibleSkills.length;

const hasDoc = Boolean(entry.body);
const hasDemo = hasDemoImages(entry);
const hasFooter = hasDemo || hasDoc;
---

<article
  class:list={[
    'grid h-87.5 min-h-0 overflow-hidden rounded-2xl',
    'border border-slate-200/80 bg-white px-4 py-4 sm:px-4',
    hasFooter
      ? 'grid-rows-[52px_minmax(0,1fr)_40px]'
      : 'grid-rows-[52px_minmax(0,1fr)]',
  ]}>
  <!-- Header -->
  <header class="min-w-0 border-b border-slate-200">
    <h3
      class="truncate text-sm font-bold tracking-[-0.03em] text-slate-950 sm:text-base">
      {entry.data.title}
    </h3>

    <time
      class="mt-0.5 block text-xs font-semibold tracking-[0.06em] text-slate-500">
      {entry.data.period}
    </time>
  </header>

  <!-- Contents -->
  <div class="grid min-h-0 grid-rows-[minmax(0,1fr)_32px] gap-3 py-2">
    <!-- Highlights -->
    <div
      class="relative min-h-0 overflow-y-auto overscroll-contain pr-2
        mask-[linear-gradient(to_bottom,black_calc(100%-16px),transparent)]"
      data-project-card-scroll>
      {
        entry.data.highlights.length > 0 && (
          <ul class="space-y-2" aria-label="주요 성과">
            {entry.data.highlights.map((highlight) => (
              <HL highlight={highlight} />
            ))}
          </ul>
        )
      }
    </div>

    <!-- Skills -->
    <div class="flex min-w-0 items-center">
      {
        visibleSkills.length > 0 && (
          <ul
            class="flex min-w-0 items-center gap-1.5 overflow-hidden"
            aria-label={`${entry.data.title} 기술 스택`}>
            {visibleSkills.map((skill) => (
              <SkillItem name={skill} showName={false} compact />
            ))}

            {hasHiddenSkills && (
              <li
                class="shrink-0 px-0.5 text-xs font-semibold text-slate-500"
                aria-label="기술 스택 더 있음">
                …
              </li>
            )}
          </ul>
        )
      }
    </div>
  </div>

  <!-- Footer -->
  {
    hasFooter && (
      <footer
        class="flex min-w-0 items-center justify-end gap-2 border-t border-slate-200 pt-2"
        aria-label={`${entry.data.title} 링크`}>
        {hasDemo && (
          <div>
            <DemoBtn entry={entry} />
          </div>
        )}
        {hasDoc && (
          <div>
            <ReadmeBtn entry={entry} />
          </div>
        )}
      </footer>
    )
  }
</article>
