---
import type { ProjectSummary } from '../../../../content/collections/projects';
import SkillItem from '../../../SkillItem.astro';
import HL from '../HL.astro';

interface Props {
  project: ProjectSummary;
}

const { project } = Astro.props;
const visibleSkills = project.stack?.slice(0, 3) ?? [];
const hasHiddenSkills = (project.stack?.length ?? 0) > visibleSkills.length;
---

<article
  class="flex h-[250px] min-h-0 flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white px-4 py-3 sm:px-5">
  <header class="min-w-0 shrink-0">
    <h3
      class="text-sm font-bold tracking-[-0.03em] text-slate-950 sm:text-base">
      {project.title}
    </h3>

    <time class="text-xs font-semibold tracking-[0.06em] text-slate-500">
      {project.period}
    </time>
  </header>

  <hr
    class="my-3 h-px shrink-0 border-0 bg-gradient-to-r from-slate-300 via-slate-200 to-transparent"
  />

  <div
    class="min-h-0 flex-1 overflow-y-auto overscroll-contain pr-2"
    data-project-card-scroll>
    <ul class="space-y-2" aria-label="주요 성과">
      {project.highlights.map((highlight) => <HL highlight={highlight} />)}
    </ul>
  </div>

  {
    visibleSkills.length > 0 && (
      <ul
        class="flex min-w-0 shrink-0 flex-nowrap gap-1.5 overflow-hidden pt-2 [&>li]:shrink-0"
        aria-label={`${project.title} 기술 스택`}>
        {visibleSkills.map((skill) => (
          <SkillItem name={skill} showName={false} compact />
        ))}

        {hasHiddenSkills && (
          <li
            class="px-0.5 py-0.5 text-xs font-semibold text-slate-500"
            aria-label="기술 스택 더 있음">
            …
          </li>
        )}
      </ul>
    )
  }
</article>
