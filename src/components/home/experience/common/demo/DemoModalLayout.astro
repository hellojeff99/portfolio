---
import { Icon } from 'astro-icon/components';
const { id } = Astro.props;
---

<dialog
  id={`demo-modal-${id}`}
  class="modal modal-bottom bg-slate-950/70 sm:modal-middle"
  aria-labelledby={`${id}-title`}>
  <div
    class="modal-box flex h-[78dvh] w-full max-w-none flex-col overflow-hidden
           rounded-t-2xl border border-base-300 bg-base-100 p-0 shadow-2xl
           sm:h-[70dvh] sm:max-w-3xl sm:rounded-2xl">
    <!-- Header -->
    <header
      class="flex shrink-0 items-center justify-between
             border-b border-base-300 px-5 py-3">
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em]
                 text-base-content/40">
          Demo
        </p>
      </div>

      <form method="dialog">
        <button
          type="submit"
          class="btn btn-circle btn-ghost btn-sm text-base-content/60"
          aria-label="모달 닫기">
          <Icon name="lucide:x" class="size-5" aria-hidden="true" />
        </button>
      </form>
    </header>
    <slot />
  </div>
  <form method="dialog" class="modal-backdrop">
    <button type="submit" aria-label="모달 닫기">close</button>
  </form>
</dialog>

<script>
  const openButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-modal-open]');

  for (const button of openButtons) {
    if (button.dataset.modalBound === 'true') {
      continue;
    }

    button.dataset.modalBound = 'true';

    button.addEventListener('click', () => {
      const modalId = button.dataset.modalOpen;

      if (!modalId) {
        return;
      }

      const modal = document.getElementById(modalId);

      if (modal instanceof HTMLDialogElement) {
        modal.showModal();
      }
    });
  }
</script>
