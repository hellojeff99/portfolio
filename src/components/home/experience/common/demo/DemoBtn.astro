---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import DemoModal from './DemoModal.astro';

interface Props {
    entry: CollectionEntry<'career' | 'projects'>;
    isCompact?: boolean;
}

const { entry, isCompact = false } = Astro.props;
---

<button
  type="button"
  data-modal-open={`demo-modal-${entry.id}`}
  class:list={[
      `group ml-auto inline-flex shrink-0 cursor-pointer items-center justify-center
    rounded-md border border-slate-200
    bg-white
    font-medium text-slate-600
    shadow-sm
    transition
    hover:border-blue-300 hover:bg-blue-50 hover:text-blue-600
    hover:shadow
    active:translate-y-px
    focus-visible:outline-none
    focus-visible:ring-2 focus-visible:ring-blue-500
    focus-visible:ring-offset-2
    dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300
    dark:hover:border-blue-500/50 dark:hover:bg-blue-500/10 dark:hover:text-blue-400
    motion-reduce:transform-none motion-reduce:transition-none`,
      isCompact
        ? 'gap-1 px-1.5 py-0.5 text-xs'
        : 'gap-1.5 px-2.5 py-1 text-sm',
  ]}
  aria-label={`${entry.data.title} DEMO 보기`}
>
    <Icon
      name="mdi:image-multiple-outline"
      class:list={[
          `shrink-0 transition-transform group-hover:scale-105
      motion-reduce:transform-none`,
          isCompact ? 'size-3.5' : 'size-4',
      ]}
      aria-hidden="true"
    />
    <span>DEMO</span>
</button>

<DemoModal entry={entry} />