---
import type { CollectionEntry } from 'astro:content';
import ReadmeContents from './ReadmeContents.astro';
import ReadmeInfo from './ReadmeInfo.astro';
import ReadmeModalLayout from './ReadmeModalLayout.astro';
interface Props {
  entry: CollectionEntry<'career' | 'projects'>;
}
const { entry } = Astro.props;
---

<ReadmeModalLayout id={entry.id}>
  <ReadmeInfo entry={entry} />
  <ReadmeContents entry={entry} />
</ReadmeModalLayout>
