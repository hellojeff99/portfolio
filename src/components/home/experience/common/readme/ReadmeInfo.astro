---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import SkillItem from '../../../../SkillItem.astro';

type Props = {
  entry: CollectionEntry<'career'> | CollectionEntry<'projects'>;
};

const { entry } = Astro.props;
const { collection, data } = entry;
---

{
  collection === 'career' && (
    <section
      class="mb-5 overflow-hidden bg-base-100"
      aria-labelledby="career-title">
      <div class="px-4 pt-4 sm:px-8">
        <header>
          <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/50">
            <Icon name="lucide:briefcase" class="size-3.5" aria-hidden="true" />
            Career
          </p>

          <div class="mt-3">
            <h1
              id="career-title"
              class="break-words text-lg font-bold leading-tight tracking-tight sm:text-lg">
              {data.title}
            </h1>

            <p class="mt-1.5 flex items-center gap-2 text-sm text-base-content/60">
              <Icon
                name="lucide:building-2"
                class="size-4 shrink-0"
                aria-hidden="true"
              />
              <span>{data.company}</span>
            </p>
          </div>
        </header>

        <dl class="mt-5 grid divide-y divide-base-300 border-y border-base-300 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
          <div class="py-2 sm:pr-5">
            <dt class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/45">
              <Icon
                name="lucide:user-round"
                class="size-4"
                aria-hidden="true"
              />
              Role
            </dt>

            <dd class="mt-1.5 font-medium leading-relaxed">{data.role}</dd>
          </div>

          <div class="py-2 sm:pl-5">
            <dt class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/45">
              <Icon
                name="lucide:calendar-days"
                class="size-4"
                aria-hidden="true"
              />
              Period
            </dt>

            <dd class="mt-1.5 font-medium leading-relaxed">
              <time>{data.period}</time>
            </dd>
          </div>
        </dl>

        {data.stack && data.stack.length > 0 && (
          <section class="mt-5" aria-labelledby="career-stack">
            <h2
              id="career-stack"
              class="flex items-center gap-2 text-sm font-semibold">
              <Icon name="lucide:code-xml" class="size-4" aria-hidden="true" />
              Tech Stack
            </h2>

            <ul class="mt-3 flex flex-wrap gap-1.5" role="list">
              {data.stack.map((technology) => (
                <SkillItem name={technology} />
              ))}
            </ul>
          </section>
        )}
      </div>
    </section>
  )
}

{
  collection === 'projects' && (
    <header
      class="overflow-hidden rounded-xl bg-base-100"
      aria-labelledby="project-title">
      <div class="px-4 pt-4 sm:px-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0 flex-1">
            <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/50">
              <Icon name="lucide:folder" class="size-3.5" aria-hidden="true" />
              Project
            </p>

            <h1
              id="project-title"
              class="mt-3 break-words text-lg font-bold leading-tight tracking-tight sm:text-lg">
              {data.title}
            </h1>

            {data.subtitle && (
              <p class="mt-2 max-w-3xl text-sm leading-relaxed text-base-content/60 sm:text-base">
                {data.subtitle}
              </p>
            )}
          </div>

          {data.github && (
            <a
              class="btn btn-outline btn-sm shrink-0 gap-2 shadow-none"
              href={data.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${data.title} GitHub 저장소 열기`}>
              <Icon name="lucide:github" class="size-4" aria-hidden="true" />
              GitHub
            </a>
          )}
        </div>

        <dl class="mt-5 grid divide-y divide-base-300 border-y border-base-300 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          <div class="py-2 sm:pr-5">
            <dt class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/45">
              <Icon
                name="lucide:user-round"
                class="size-4"
                aria-hidden="true"
              />
              Role
            </dt>

            <dd class="mt-1.5 font-medium leading-relaxed">{data.role}</dd>
          </div>

          <div class="py-2 sm:px-5">
            <dt class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/45">
              <Icon name="lucide:package-2" class="size-4" aria-hidden="true" />
              Type
            </dt>

            <dd class="mt-1.5 font-medium leading-relaxed">{data.type}</dd>
          </div>

          <div class="py-2 sm:pl-5">
            <dt class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/45">
              <Icon
                name="lucide:calendar-days"
                class="size-4"
                aria-hidden="true"
              />
              Period
            </dt>

            <dd class="mt-1.5 font-medium leading-relaxed">
              <time>{data.period}</time>
            </dd>
          </div>
        </dl>

        {data.stack && data.stack.length > 0 && (
          <section class="mt-5" aria-labelledby="project-stack">
            <h2
              id="project-stack"
              class="flex items-center gap-2 text-sm font-semibold">
              <Icon name="lucide:code-xml" class="size-4" aria-hidden="true" />
              Tech Stack
            </h2>

            <ul class="mt-3 flex flex-wrap gap-1.5" role="list">
              {data.stack.map((technology) => (
                <SkillItem name={technology} />
              ))}
            </ul>
          </section>
        )}
      </div>
    </header>
  )
}
