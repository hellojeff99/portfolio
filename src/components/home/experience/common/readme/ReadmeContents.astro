---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'career' | 'projects'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<section class="readme">
  <article class="readme__content">
    <Content />
  </article>
</section>

<style>
  .readme {
    --readme-blue: #2563eb;
    --readme-blue-light: #3b82f6;
    --readme-blue-border: rgba(37, 99, 235, 0.22);

    overflow: hidden;
    color: var(--color-base-content, #1f2937);
    background: var(--color-base-100, #ffffff);
  }

  .readme__content {
    max-width: none;
    overflow-wrap: anywhere;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .readme__content :global(> *:first-child) {
    margin-top: 0;
  }

  .readme__content :global(> *:last-child) {
    margin-bottom: 0;
  }

  .readme__content :global(h1),
  .readme__content :global(h2),
  .readme__content :global(h3),
  .readme__content :global(h4) {
    color: var(--color-base-content, #111827);
    line-height: 1.3;
    letter-spacing: -0.025em;
    scroll-margin-top: 5rem;
  }

  .readme__content :global(h1) {
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-base-300, #e5e7eb);
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 800;
  }

  .readme__content :global(h2) {
    position: relative;
    margin: 2rem 0 0.75rem;
    padding: 0 0 0.5rem 0.75rem;
    font-size: 1.25rem;
    font-weight: 750;
  }

  .readme__content :global(h2::before) {
    position: absolute;
    top: 0.15em;
    bottom: 0.6rem;
    left: 0;
    width: 0.2rem;
    background: linear-gradient(
      180deg,
      var(--readme-blue-light),
      var(--readme-blue)
    );
    border-radius: 9999px;
    content: '';
  }

  .readme__content :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .readme__content :global(h4) {
    margin: 1.25rem 0 0.4rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .readme__content :global(p) {
    margin: 0.65rem 0;
    line-height: 1.7;
  }

  .readme__content :global(strong) {
    color: var(--color-base-content, #111827);
    font-weight: 700;
  }

  .readme__content :global(a) {
    color: var(--readme-blue);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: rgba(37, 99, 235, 0.35);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2rem;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }

  .readme__content :global(a:hover) {
    color: #1d4ed8;
    text-decoration-color: currentColor;
  }

  .readme__content :global(ul),
  .readme__content :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }

  .readme__content :global(ul) {
    list-style-type: disc;
  }

  .readme__content :global(ol) {
    list-style-type: decimal;
  }

  .readme__content :global(li) {
    margin: 0.2rem 0;
    padding-left: 0.15rem;
    line-height: 1.65;
  }

  .readme__content :global(li::marker) {
    /* color: var(--readme-blue-light); */
    font-weight: 700;
  }

  .readme__content :global(li > ul),
  .readme__content :global(li > ol) {
    margin: 0.25rem 0;
  }

  .readme__content :global(blockquote) {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    color: color-mix(
      in srgb,
      var(--color-base-content, #1f2937) 72%,
      transparent
    );
    background: linear-gradient(
      90deg,
      rgba(37, 99, 235, 0.1),
      rgba(37, 99, 235, 0.035)
    );
    border: 1px solid var(--readme-blue-border);
    border-left: 0.25rem solid var(--readme-blue);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .readme__content :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .readme__content :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .readme__content :global(hr) {
    margin: 1.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-base-300, #e5e7eb);
  }

  .readme__content :global(pre) {
    margin: 1rem 0;
    padding: 1rem;
    overflow-x: auto;
    color: #dbeafe;
    background: #0f172a;
    border: 1px solid rgba(96, 165, 250, 0.2);
    border-radius: 0.5rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 4px 12px rgba(15, 23, 42, 0.1);
    font-size: 0.875rem;
    line-height: 1.6;
    tab-size: 2;
  }

  .readme__content :global(pre code) {
    padding: 0;
    color: inherit;
    background: transparent;
    border: 0;
    font-size: inherit;
  }

  .readme__content :global(:not(pre) > code) {
    padding: 0.15rem 0.4rem;
    color: #93c5fd;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 0.375rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      monospace;
    font-size: 0.875em;
    font-weight: 600;
  }

  .readme__content :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 1rem auto;
    border: 0;
    border-radius: 0;
  }

  .readme__content :global(figure) {
    margin: 1rem 0;
  }

  .readme__content :global(figure img) {
    margin: 0 auto;
  }

  .readme__content :global(figcaption) {
    margin-top: 0.5rem;
    color: color-mix(
      in srgb,
      var(--color-base-content, #1f2937) 50%,
      transparent
    );
    font-size: 0.8rem;
    text-align: center;
  }

  .readme__content :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1rem 0;
    overflow-x: auto;
    border-collapse: collapse;
    border-spacing: 0;
    font-size: 0.875rem;
  }

  .readme__content :global(th),
  .readme__content :global(td) {
    min-width: 8rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-base-300, #e5e7eb);
    text-align: left;
    vertical-align: top;
  }

  .readme__content :global(th) {
    color: var(--color-base-content, #111827);
    background: rgba(37, 99, 235, 0.07);
    font-weight: 700;
  }

  .readme__content :global(tbody tr) {
    transition: background-color 150ms ease;
  }

  .readme__content :global(tbody tr:hover) {
    background: rgba(37, 99, 235, 0.035);
  }

  .readme__content :global(details) {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    background: var(--color-base-100, #ffffff);
    border: 1px solid var(--color-base-300, #e5e7eb);
    border-radius: 0.5rem;
  }

  .readme__content :global(summary) {
    color: var(--color-base-content, #111827);
    cursor: pointer;
    font-weight: 700;
  }

  .readme__content :global(mark) {
    padding: 0.1rem 0.25rem;
    color: inherit;
    background: rgba(96, 165, 250, 0.25);
    border-radius: 0.25rem;
  }

  .readme__content :global(kbd) {
    padding: 0.15rem 0.4rem;
    color: var(--color-base-content, #111827);
    background: var(--color-base-200, #f1f5f9);
    border: 1px solid var(--color-base-300, #cbd5e1);
    border-bottom-width: 2px;
    border-radius: 0.375rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      monospace;
    font-size: 0.8em;
  }

  @media (min-width: 640px) {
    .readme {
      padding: 1.25rem; /* 기존 1.25rem의 절반 */
    }

    .readme__content {
      font-size: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .readme {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .readme__content :global(a),
    .readme__content :global(tbody tr) {
      transition: none;
    }
  }
</style>
