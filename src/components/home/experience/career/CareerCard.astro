---
import type { CollectionEntry } from 'astro:content';
import SkillItem from '../../../SkillItem.astro';
import ReadmeBtn from '../common/readme/ReadmeBtn.astro';
import HL from '../HL.astro';

interface Props {
  entry: CollectionEntry<'career'>;
}

const { entry } = Astro.props;
const stack = entry.data.stack?.slice(0, 4) ?? [];
const hasDoc = Boolean(entry.body);
---

<article
  class="relative flex h-full flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-5 sm:p-6">
  <div
    class="absolute top-0 left-5 h-1 w-12 rounded-b-full bg-slate-800 sm:left-6"
    aria-hidden="true">
  </div>

  <!-- Header -->
  <header class="flex flex-col gap-3">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-xs font-bold tracking-[0.12em] text-slate-500 uppercase">
          {entry.data.role}
        </p>

        <h3
          class="mt-2 line-clamp-2 text-xl font-bold tracking-[-0.04em] text-base-content sm:text-2xl">
          {entry.data.title}
        </h3>

        <p class="mt-1.5 text-sm leading-6 font-bold text-base-content/60">
          {entry.data.company}
        </p>
      </div>

      <time
        class="shrink-0 rounded-full border border-base-300 bg-base-200/55 px-2.5 py-1 text-xs font-semibold text-base-content/60">
        {entry.data.period}
      </time>
    </div>

    {
      stack.length > 0 && (
        <ul
          class="flex flex-wrap gap-x-3 gap-y-1.5"
          aria-label={`${entry.data.title} 기술 스택`}>
          {stack.map((skill) => (
            <SkillItem name={skill} showName={false} />
          ))}
        </ul>
      )
    }
  </header>

  <hr class="my-4 h-px shrink-0 border-0 bg-base-300" />

  <!-- Contents -->
  <ul class="flex-1 space-y-5" aria-label="주요 성과">
    {entry.data.highlights.map((highlight) => <HL highlight={highlight} />)}
  </ul>

  <!-- Footer -->
  {
    hasDoc && (
      <footer class="mt-6 flex items-end justify-end gap-4">
        <ReadmeBtn entry={entry} />
      </footer>
    )
  }
</article>
