---
import type { CollectionEntry } from 'astro:content';
import SkillItem from '../../../SkillItem.astro';
import HL from '../HL.astro';

interface Props {
  career: CollectionEntry<'career'>;
}

const { career } = Astro.props;
const stack = career.data.stack?.slice(0, 4) ?? [];
---

<article
  class="relative flex h-full flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-5 sm:p-6">
  <div
    class="absolute top-0 left-5 h-1 w-12 rounded-b-full bg-slate-800 sm:left-6"
    aria-hidden="true">
  </div>

  <header class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-bold tracking-[0.12em] text-slate-500 uppercase">
        {career.data.meta}
      </p>

      <h3
        class="mt-2 text-xl font-bold tracking-[-0.04em] text-base-content sm:text-2xl">
        {career.data.title}
      </h3>

      {
        career.data.subtitle && (
          <p class="mt-1.5 text-sm leading-6 font-bold text-base-content/60">
            {career.data.subtitle}
          </p>
        )
      }
    </div>

    <time
      class="shrink-0 rounded-full border border-base-300 bg-base-200/55 px-2.5 py-1 text-xs font-semibold text-base-content/60">
      {career.data.period}
    </time>
  </header>

  <hr
    class="my-4 h-px shrink-0 border-0 bg-gradient-to-r from-slate-300 via-slate-200 to-transparent"
  />

  <ul class="space-y-5" aria-label="주요 성과">
    {career.data.highlights.map((highlight) => <HL highlight={highlight} />)}
  </ul>

  {
    stack.length > 0 && (
      <ul
        class="mt-auto flex flex-wrap gap-x-3 gap-y-1.5 pt-6"
        aria-label={`${career.data.title} 기술 스택`}>
        {stack.map((skill) => (
          <SkillItem name={skill} showName={false} />
        ))}
      </ul>
    )
  }
</article>
