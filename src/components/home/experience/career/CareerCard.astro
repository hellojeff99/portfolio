---
import { FileText } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import SkillItem from "../../../SkillItem.astro";
import ReadmeModal from "../readme/ReadmeModal.astro";
import {getHighlightTitle} from "../../../../content/collections/highlightScheam.ts";

interface Props {
  career: CollectionEntry<"career">;
}

const { career } = Astro.props;
const readmeModalId = `readme-${career.id.replaceAll("/", "-")}`;
const hasDocument = Boolean(career.body?.trim());

---

<div
  class:list={[
    "relative flex h-full flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-5 transition-colors duration-200 motion-reduce:transition-none sm:p-6",
    hasDocument && "group/career-card cursor-pointer hover:border-slate-400",
  ]}
>
  {
    hasDocument && (
      <button
        type="button"
        class="absolute inset-0 z-10 cursor-pointer rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-inset"
        data-readme-open={readmeModalId}
        aria-label={`${career.data.title} README 보기`}
      >
        <span class="sr-only">{career.data.title} README 보기</span>
      </button>
    )
  }

  <span
    class="absolute left-5 top-0 h-1 w-12 rounded-b-full bg-slate-800 sm:left-6"
    aria-hidden="true"></span>

  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-bold tracking-[0.12em] text-slate-500 uppercase">
        {career.data.meta}
      </p>
      <h4
        class="mt-2 text-xl font-bold tracking-[-0.04em] text-base-content sm:text-2xl"
      >
        {career.data.title}
      </h4>

      {
        career.data.subtitle && (
          <p class="mt-1.5 text-sm leading-6 text-base-content/60">
            {career.data.subtitle}
          </p>
        )
      }
    </div>
    <time
      class="shrink-0 rounded-full border border-base-300 bg-base-200/55 px-2.5 py-1 text-xs font-semibold text-base-content/60"
    >
      {career.data.period}
    </time>
  </div>

  <div
    class="my-5 h-px from-slate-300 via-slate-200 to-transparent"
    aria-hidden="true"
  >
  </div>

  <ul class="space-y-3" aria-label="주요 성과">
    {
      career.data.highlights.slice(0, 2).map((highlight) => (
        <li class="flex items-start gap-3">
          <span
            class="mt-2.5 size-1.5 shrink-0 rounded-full bg-slate-800"
            aria-hidden="true"
          />
          <span class="text-sm font-medium leading-6 text-base-content/90">
            {getHighlightTitle(highlight)}
          </span>
        </li>
      ))
    }
  </ul>

  {
    (career.data.stack?.length || hasDocument) && (
      <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
        {career.data.stack && career.data.stack.length > 0 && (
          <ul
            class="flex flex-wrap gap-x-3 gap-y-1.5 px-3 py-2"
            aria-label={`${career.data.title} 기술 스택`}
          >
            {career.data.stack.slice(0, 4).map((skill) => (
              <SkillItem name={skill} showName={false} />
            ))}
          </ul>
        )}
        {hasDocument && (
          <span
            class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-600 shadow-sm transition-colors duration-200 group-hover/career-card:border-slate-950 group-hover/career-card:bg-slate-950 group-hover/career-card:text-white motion-reduce:transition-none"
            aria-hidden="true"
          >
            <FileText class="size-3.5" stroke-width={2} />
            <span>README</span>
          </span>
        )}
      </div>
    )
  }
</div>

{hasDocument && <ReadmeModal modalId={readmeModalId} project={career} />}
