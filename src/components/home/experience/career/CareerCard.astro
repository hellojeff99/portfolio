---
import type { CollectionEntry } from 'astro:content';
import SkillItem from '../../../SkillItem.astro';
import HL from '../HL.astro';
import ReadmeBtn from '../readme/ReadmeBtn.astro';

interface Props {
  entry: CollectionEntry<'career'>;
}

const { entry } = Astro.props;
const stack = entry.data.stack?.slice(0, 4) ?? [];
const hasDoc = Boolean(entry.body);
---

<article
  class:list={[
    'relative flex h-full flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-5 sm:p-6',
  ]}>
  <div
    class="absolute top-0 left-5 h-1 w-12 rounded-b-full bg-slate-800 sm:left-6"
    aria-hidden="true">
  </div>

  <!-- Header -->
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-bold tracking-[0.12em] text-slate-500 uppercase">
        {entry.data.role}
      </p>

      <h3
        class="mt-2 text-xl font-bold tracking-[-0.04em] text-base-content sm:text-2xl">
        {entry.data.title}
      </h3>

      <p class="mt-1.5 text-sm leading-6 font-bold text-base-content/60">
        {entry.data.company}
      </p>
    </div>

    <time
      class="shrink-0 rounded-full border border-base-300 bg-base-200/55 px-2.5 py-1 text-xs font-semibold text-base-content/60">
      {entry.data.period}
    </time>
  </header>

  <hr
    class="my-4 h-px shrink-0 border-0 bg-gradient-to-r from-slate-300 via-slate-200 to-transparent"
  />

  <!-- Content -->
  <ul class="space-y-5" aria-label="주요 성과">
    {entry.data.highlights.map((highlight) => <HL highlight={highlight} />)}
  </ul>

  <!-- Bottom -->
  <footer class="mt-auto flex items-end justify-between gap-4 pt-6">
    {
      stack.length > 0 && (
        <ul
          class="flex flex-wrap gap-x-3 gap-y-1.5"
          aria-label={`${entry.data.title} 기술 스택`}>
          {stack.map((skill) => (
            <SkillItem name={skill} showName={false} />
          ))}
        </ul>
      )
    }
    {hasDoc && <ReadmeBtn entry={entry} />}
  </footer>
</article>
