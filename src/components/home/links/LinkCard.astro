---
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  label: string;
  href: string;
  external?: boolean;
}

const {
  eyebrow,
  title,
  description,
  label,
  href,
  external = false,
} = Astro.props;
---

<li class="min-w-0">
  <a
    class="group flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 shadow-sm transition-colors duration-200 hover:border-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 motion-reduce:transition-none sm:gap-4 sm:px-6"
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noreferrer' : undefined}>
    <span
      class="grid size-10 shrink-0 place-items-center rounded-xl bg-slate-950 text-white sm:size-12">
      <slot name="icon" />
    </span>

    <span class="min-w-0 flex-1">
      <span
        class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold tracking-[0.12em] text-slate-500 uppercase">
        {eyebrow}
      </span>
      <span class="mt-2 flex min-w-0 items-baseline gap-3">
        <span
          class="shrink-0 text-lg font-black tracking-tight text-slate-950 sm:text-xl">
          {title}
        </span>
        <span class="hidden truncate text-sm text-slate-500 sm:block">
          {description}
        </span>
      </span>
      <span class="mt-1 block truncate text-sm font-semibold text-slate-600">
        {label}
      </span>
    </span>

    <span
      class="hidden shrink-0 items-center gap-2 rounded-full border border-slate-200 px-3 py-2 text-xs font-black tracking-[0.1em] text-slate-600 transition-colors duration-200 group-hover:border-slate-950 group-hover:bg-slate-950 group-hover:text-white motion-reduce:transition-none sm:inline-flex">
      <span class="hidden sm:inline">Open</span>
      <ArrowUpRight class="size-4" aria-hidden="true" />
    </span>
  </a>
</li>
