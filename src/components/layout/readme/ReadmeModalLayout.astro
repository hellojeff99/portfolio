---
const { id } = Astro.props;
---

<dialog
  id={`readme-modal-${id}`}
  class="modal modal-bottom sm:modal-middle"
  aria-labelledby={`readme-modal-${id}`}
  -title
  aria-describedby={`readme-modal-${id}`}
  -description>
  <div class="modal-box">
    <form method="dialog">
      <button
        type="submit"
        class="btn btn-sm btn-circle btn-ghost absolute top-2 right-2"
        aria-label="모달 닫기">
        ✕
      </button>
    </form>
    <slot />
  </div>
  <form method="dialog" class="modal-backdrop">
    <button type="submit" aria-label="모달 닫기"> close </button>
  </form>
</dialog>

<script>
  const openButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-modal-open]');

  for (const button of openButtons) {
    if (button.dataset.modalBound === 'true') {
      continue;
    }

    button.dataset.modalBound = 'true';

    button.addEventListener('click', () => {
      const modalId = button.dataset.modalOpen;

      if (!modalId) {
        return;
      }

      const modal = document.getElementById(modalId);

      if (modal instanceof HTMLDialogElement) {
        modal.showModal();
      }
    });
  }
</script>
