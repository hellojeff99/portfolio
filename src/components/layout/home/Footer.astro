---
import { getEntry } from "astro:content";
import TopButton from "../TopButton.astro";

const infoEntry = await getEntry("info", "info");
const name = infoEntry?.data.info.romanName ?? "Seongwon";
---

<footer
  class="bg-gray-950 px-5 py-4 text-white sm:px-8 sm:py-5 lg:px-12"
  aria-label="사이트 정보"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
    <div>
      <p class="text-xs text-white/35">
        © {new Date().getFullYear()}
      </p>
      <p class="text-xs text-white/35">
        {name}
      </p>
    </div>
    <TopButton />
  </div>
</footer>
