---
import { Sparkles } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import type { ProjectTask } from "../../../../content/v2/collections/projects";
import SkillItem from "../../SkillItem.astro";

interface Props {
  career: CollectionEntry<"v2Projects">;
}

const { career } = Astro.props;

function getTaskTitle(task: ProjectTask): string {
  return typeof task === "string" ? task : task.title;
}
---

<div
  class="h-full rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition-all hover:border-sky-700/35 hover:shadow-md sm:p-5"
>
  <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-sky-700">{career.data.meta}</p>
      <h4
        class="mt-1 text-lg font-bold tracking-[-0.03em] text-base-content sm:text-xl"
      >
        {career.data.title}
      </h4>
      {
        career.data.subtitle && (
          <p class="mt-1 text-sm text-base-content/60">
            {career.data.subtitle}
          </p>
        )
      }
    </div>
    <time class="shrink-0 font-mono text-xs text-base-content/55">
      {career.data.period}
    </time>
  </div>

  <ul class="mt-4 space-y-2 border-t border-dashed border-base-300 pt-4">
    {
      career.data.highlights.slice(0, 2).map((highlight) => (
        <li class="flex gap-2 text-sm leading-6 text-base-content/70">
          <Sparkles
            class="mt-1 size-3 shrink-0 text-sky-700"
            stroke-width={2}
            aria-hidden="true"
          />
          <span>{getTaskTitle(highlight)}</span>
        </li>
      ))
    }
  </ul>

  {
    career.data.stack && career.data.stack.length > 0 && (
      <ul
        class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5"
        aria-label={`${career.data.title} 기술 스택`}
      >
        {career.data.stack.slice(0, 4).map((skill) => (
          <SkillItem name={skill} showName={false} />
        ))}
      </ul>
    )
  }
</div>
