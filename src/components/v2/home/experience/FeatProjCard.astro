---
import { Pin } from "@lucide/astro";
import type {
  ProjectSummary,
  ProjectTask,
} from "../../../../content/v2/collections/projects";
import SkillItem from "../../SkillItem.astro";
import ReadmeBtn from "./ReadmeBtn.astro";

interface Props {
  project: ProjectSummary;
}

const { project } = Astro.props;
const visibleSkills = project.stack?.slice(0, 5) ?? [];
const hasHiddenSkills = (project.stack?.length ?? 0) > visibleSkills.length;

function getTaskTitle(task: ProjectTask): string {
  return typeof task === "string" ? task : task.title;
}
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white"
>
  <div class="flex flex-1 flex-col px-4 py-3 sm:px-5 sm:py-4">
    <header class="min-w-0">
      <div class="flex items-center justify-between gap-3">
        <h3
          class="flex min-w-0 items-center gap-1.5 text-lg font-bold tracking-[-0.03em] text-slate-950 sm:text-xl"
        >
          <Pin
            class="shrink-0 text-blue-700"
            size={19}
            stroke-width={2.5}
            fill="currentColor"
            aria-hidden="true"
          />
          <span class="min-w-0 break-keep">{project.title}</span>
        </h3>
        <time
          class="shrink-0 font-mono text-[0.65rem] font-semibold tracking-[0.04em] text-slate-600"
        >
          {project.period}
        </time>
      </div>
      {
        project.subtitle && (
          <p class="text-xs leading-5 text-slate-600 sm:text-sm">
            {project.subtitle}
          </p>
        )
      }
    </header>

    <div
      class="my-2 h-px bg-gradient-to-r from-slate-300 via-slate-200 to-transparent"
      aria-hidden="true"
    >
    </div>
    <ul class="space-y-1.5">
      {
        project.highlights.slice(0, 3).map((highlight) => (
          <li class="flex items-start gap-2 text-xs leading-5 font-medium text-slate-900 sm:text-sm">
            <span
              class="mt-2 size-1 shrink-0 rounded-full bg-slate-400"
              aria-hidden="true"
            />
            <span>{getTaskTitle(highlight)}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-3">
      {
        visibleSkills.length > 0 && (
          <div class="inline-flex max-w-full px-2 py-1.5">
            <ul
              class="flex max-w-full flex-nowrap gap-1.5 [&>li]:shrink-0"
              aria-label={`${project.title} 기술 스택`}
            >
              {visibleSkills.map((skill) => (
                <SkillItem name={skill} showName={false} />
              ))}
              {hasHiddenSkills && (
                <li
                  class="px-0.5 py-0.5 text-[0.65rem] font-semibold text-slate-500"
                  aria-label="기술 스택 더 있음"
                >
                  …
                </li>
              )}
            </ul>
          </div>
        )
      }
      {
        project.github && (
          <ReadmeBtn href={project.github} projectTitle={project.title} />
        )
      }
    </div>
  </div>
</article>
