---
import { FileText } from "@lucide/astro";

interface Props {
  modalId: string;
  projectTitle: string;
  showText?: boolean;
}

const { modalId, projectTitle, showText = true } = Astro.props;
---

<button
  type="button"
  class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-blue-500 px-2.5 py-1.5 text-xs font-bold text-white transition-colors hover:bg-blue-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
  data-readme-open={modalId}
  aria-label={`${projectTitle} README 보기`}
>
  <FileText class="size-3.5" stroke-width={2} aria-hidden="true" />
  {showText && <span>README</span>}
</button>
