---
import type { CollectionEntry } from "astro:content";
import type { ProjectTask } from "../../../../../content/v2/collections/projects";
import ReadmeBtn from "../readme/ReadmeBtn.astro";
import ReadmeModal from "../readme/ReadmeModal.astro";
import SkillItem from "../../../SkillItem.astro";

interface Props {
  career: CollectionEntry<"v2Projects">;
}

const { career } = Astro.props;
const readmeModalId = `readme-${career.id.replaceAll("/", "-")}`;
const hasDocument = Boolean(career.body?.trim());

function getTaskTitle(task: ProjectTask): string {
  return typeof task === "string" ? task : task.title;
}
---

<div
  class="relative flex h-full flex-col overflow-hidden rounded-2xl border border-base-300 bg-base-100 p-5 sm:p-6"
>
  <span
    class="absolute left-5 top-0 h-1 w-12 rounded-b-full bg-slate-800 sm:left-6"
    aria-hidden="true"></span>

  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-bold tracking-[0.12em] text-slate-500 uppercase">
        {career.data.meta}
      </p>
      <h4
        class="mt-2 text-xl font-bold tracking-[-0.04em] text-base-content sm:text-2xl"
      >
        {career.data.title}
      </h4>

      {
        career.data.subtitle && (
          <p class="mt-1.5 text-sm leading-6 text-base-content/60">
            {career.data.subtitle}
          </p>
        )
      }
    </div>
    <time
      class="shrink-0 rounded-full border border-base-300 bg-base-200/55 px-2.5 py-1 font-mono text-xs font-semibold text-base-content/60"
    >
      {career.data.period}
    </time>
  </div>

  <div
    class="my-5 h-px bg-gradient-to-r from-slate-300 via-slate-200 to-transparent"
    aria-hidden="true"
  >
  </div>

  <ul class="space-y-3" aria-label="주요 성과">
    {
      career.data.highlights.slice(0, 2).map((highlight) => (
        <li class="flex items-start gap-3">
          <span
            class="mt-2.5 size-1.5 shrink-0 rounded-full bg-slate-800"
            aria-hidden="true"
          />
          <span class="text-sm font-medium leading-6 text-base-content/90">
            {getTaskTitle(highlight)}
          </span>
        </li>
      ))
    }
  </ul>

  {
    (career.data.stack?.length || hasDocument) && (
      <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
        {career.data.stack && career.data.stack.length > 0 && (
          <ul
            class="flex flex-wrap gap-x-3 gap-y-1.5 px-3 py-2"
            aria-label={`${career.data.title} 기술 스택`}
          >
            {career.data.stack.slice(0, 4).map((skill) => (
              <SkillItem name={skill} showName={false} />
            ))}
          </ul>
        )}
        {hasDocument && (
          <ReadmeBtn modalId={readmeModalId} projectTitle={career.data.title} />
        )}
      </div>
    )
  }
</div>

{hasDocument && <ReadmeModal modalId={readmeModalId} project={career} />}
