---
import { getEntry } from "astro:content";

const resumeEntry = await getEntry("v2Resume", "resume");

const profile = resumeEntry?.data.about;
const name = profile?.name?.trim();
const role = profile?.role?.trim();
const label = "DEV PORTFOLIO";
const summary = profile?.summary?.trim() || "프로필 정보를 준비 중입니다.";
const headlineWords = summary.split(/\s+/);
const headlineSplitIndex = Math.ceil(headlineWords.length / 2);
const headline =
  headlineWords.length > 1
    ? `${headlineWords.slice(0, headlineSplitIndex).join(" ")}\n${headlineWords.slice(headlineSplitIndex).join(" ")}`
    : summary;
---

<section
  id="hero"
  class="flex min-h-[50svh] items-center bg-[url('/hero_bg_1.png')] bg-cover bg-center bg-no-repeat px-5 py-16 sm:px-8 lg:px-12"
>
  <div class="mx-auto w-full max-w-6xl text-center">
    <p
      class="mb-4 inline-flex rounded-full border border-sky-300/30 bg-slate-950/50 px-4 py-2 font-mono text-xl font-semibold tracking-[0.18em] text-white uppercase backdrop-blur-sm sm:text-2xl"
    >
      {label}
    </p>
    {
      name && (
        <p class="text-4xl font-black tracking-[0.24em] text-white sm:text-5xl">
          -{name}-
        </p>
      )
    }
    {
      role && (
        <p class="mt-3 text-lg font-medium tracking-[0.12em] text-sky-100/80 sm:text-xl">
          {role}
        </p>
      )
    }
    {
      (name || role) && (
        <div class="mx-auto mt-10 mb-10 h-px w-16 bg-sky-200/60" />
      )
    }
    <p
      class="relative mx-auto max-w-4xl text-balance text-base leading-[1.25] font-bold tracking-[-0.025em] text-white/90 sm:text-lg lg:text-xl"
    >
      <span class="sr-only">{summary}</span>
      <span class="invisible whitespace-pre-line" aria-hidden="true"
        >{headline}</span
      >
      <span
        class="absolute inset-0 whitespace-pre-line"
        data-hero-typing
        data-text={headline}
        aria-hidden="true"
      >
        <span data-hero-typing-text></span>
        <span
          class="ml-1 inline-block h-[0.85em] w-[0.08em] translate-y-[0.08em] bg-sky-300 align-baseline motion-safe:animate-pulse motion-reduce:hidden"
          data-hero-typing-cursor></span>
      </span>
    </p>
  </div>
</section>

<script>
  const initializeHeroTyping = () => {
    const typingElement =
      document.querySelector<HTMLElement>("[data-hero-typing]");

    if (!typingElement || typingElement.dataset.typingReady === "true") {
      return;
    }

    const textElement = typingElement.querySelector<HTMLElement>(
      "[data-hero-typing-text]",
    );
    const cursorElement = typingElement.querySelector<HTMLElement>(
      "[data-hero-typing-cursor]",
    );
    const text = typingElement.dataset.text ?? "";

    if (!textElement || !cursorElement) {
      return;
    }

    typingElement.dataset.typingReady = "true";

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      textElement.textContent = text;
      cursorElement.hidden = true;
      return;
    }

    const characters = Array.from(text);
    let index = 0;

    const typeNextCharacter = () => {
      index += 1;
      textElement.textContent = characters.slice(0, index).join("");

      if (index < characters.length) {
        window.setTimeout(typeNextCharacter, 65);
      }
    };

    window.setTimeout(typeNextCharacter, 350);
  };

  initializeHeroTyping();
  document.addEventListener("astro:page-load", initializeHeroTyping);
</script>
