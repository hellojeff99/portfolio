---
import { BriefcaseBusiness, Code2, UserRound } from "@lucide/astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
  icon?: "about" | "skills" | "experience";
}

const { eyebrow, title, description, id, icon } = Astro.props;
const icons = {
  about: UserRound,
  skills: Code2,
  experience: BriefcaseBusiness,
};
const Icon = icon && icons[icon];
---

<header class="mx-auto max-w-3xl text-center font-['Wanted_Sans'] font-bold">
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@latest/fonts/webfonts/wanted-sans.css"
  />
  {
    eyebrow && (
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-sky-700/35" aria-hidden="true" />
        <p class="rounded-full border border-sky-700/15 bg-sky-700/5 px-3 py-1 font-mono text-[0.65rem] font-bold uppercase tracking-[0.18em] text-sky-700">
          {eyebrow}
        </p>
        <span class="h-px w-8 bg-sky-700/35" aria-hidden="true" />
      </div>
    )
  }
  <div
    class:list={["flex items-center justify-center gap-3", eyebrow && "mt-5"]}
  >
    {
      Icon && (
        <span class="inline-grid size-11 shrink-0 place-items-center rounded-2xl border border-sky-700/15 bg-sky-700/5 text-sky-700 shadow-sm shadow-sky-700/5 sm:size-12">
          <Icon class="size-5" stroke-width={1.8} aria-hidden="true" />
        </span>
      )
    }
    <h2
      class="text-4xl font-bold uppercase tracking-[-0.04em] text-base-content sm:text-5xl"
      id={id}
    >
      {title}
    </h2>
  </div>
  <div class="mt-6 flex items-center justify-center gap-2" aria-hidden="true">
    <span class="h-1.5 w-1.5 rounded-full bg-sky-700"></span>
    <span class="h-px w-12 bg-sky-700/45"></span>
    <span class="h-1.5 w-1.5 rounded-full bg-sky-700"></span>
  </div>
  {
    description && (
      <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-base-content/65 sm:text-lg">
        {description}
      </p>
    )
  }
</header>
