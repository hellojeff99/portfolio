---
import { getEntry } from "astro:content";

const resumeEntry = await getEntry("v2Resume", "resume");

if (!resumeEntry) {
  throw new Error("v2 Resume Info에 필요한 이력서 데이터를 찾을 수 없습니다.");
}

const { info } = resumeEntry.data;
---

<section class="px-16 py-4 print:break-inside-avoid print:px-12 print:py-2">
  <div
    class="grid grid-cols-4 items-start gap-x-8 print:grid-cols-[auto_minmax(0,1fr)] print:gap-x-6"
  >
    <figure class="m-0 self-start print:w-36">
      <div
        class="aspect-[4/5] overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 print:rounded-lg"
      >
        <img
          src={info.photo}
          alt={`${info.name} 프로필 사진`}
          width="352"
          height="440"
          class="size-full object-cover object-top"
        />
      </div>
    </figure>

    <div class="col-span-3 min-w-0 print:col-span-1">
      <header>
        <h1
          class="mt-4 text-3xl font-extrabold leading-none tracking-[-0.04em] text-slate-950 print:mt-1 print:text-2xl"
        >
          {info.name}
        </h1>
        <p
          class="mt-1.5 text-lg font-semibold leading-tight tracking-tight print:text-base"
          data-resume-role
        >
          {info.role}
        </p>
      </header>

      <dl
        class="mt-8 grid grid-cols-2 gap-x-8 gap-y-4 border-t border-slate-200 pt-3 print:mt-4 print:gap-y-2 print:pt-2"
      >
        {
          info.birthDate && (
            <div class="min-w-0">
              <dt
                class="text-xs font-bold tracking-[0.14em] text-slate-400"
                data-resume-info-label="birthDate"
                data-resume-info-label-default="BIRTH"
              >
                BIRTH
              </dt>
              <dd class="mt-0.5 text-xs font-semibold leading-snug tracking-tight text-slate-700">
                {info.birthDate}
              </dd>
            </div>
          )
        }
        <div class="min-w-0">
          <dt
            class="text-xs font-bold tracking-[0.14em] text-slate-400"
            data-resume-info-label="email"
            data-resume-info-label-default="EMAIL"
          >
            EMAIL
          </dt>
          <dd
            class="mt-0.5 text-xs font-semibold leading-snug tracking-tight text-slate-700"
          >
            <a href={`mailto:${info.email}`}>{info.email}</a>
          </dd>
        </div>
        <div class="min-w-0">
          <dt
            class="text-xs font-bold tracking-[0.14em] text-slate-400"
            data-resume-info-label="phone"
            data-resume-info-label-default="PHONE"
          >
            PHONE
          </dt>
          <dd
            class="mt-0.5 text-xs font-semibold leading-snug tracking-tight text-slate-700"
          >
            <a href={`tel:${info.phone}`} data-resume-phone>{info.phone}</a>
          </dd>
        </div>
        <div class="min-w-0">
          <dt
            class="text-xs font-bold tracking-[0.14em] text-slate-400"
            data-resume-info-label="location"
            data-resume-info-label-default="LOCATION"
          >
            LOCATION
          </dt>
          <dd
            class="mt-0.5 text-xs font-semibold leading-snug tracking-tight text-slate-700"
          >
            {info.location}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
