---
import type {
  ProjectEntry,
  ProjectTask,
} from "../../../../content/v2/collections/projects";
import BulletText from "../common/BulletText.astro";
import SkillLabel from "../common/SkillLabel.astro";
import TextLabel from "../common/TextLabel.astro";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;

function getTaskTitle(task: ProjectTask): string {
  return typeof task === "string" ? task : task.title;
}
---

<article class="print:break-inside-avoid">
  <header
    class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-x-8"
  >
    <div class="min-w-0">
      <h3
        class="m-0 text-base font-bold tracking-tight text-slate-950 print:text-sm"
      >
        {data.title}
      </h3>
      {
        data.subtitle && (
          <p class="mt-1.5 text-xs leading-5 font-normal text-slate-600 print:mt-1 print:leading-4">
            {data.subtitle}
          </p>
        )
      }
    </div>

    <div class="flex flex-wrap items-center gap-2 sm:justify-end">
      {data.type && <TextLabel text={data.type} />}
      <TextLabel text={data.period} />
    </div>
  </header>

  <ul
    class="mt-4 grid gap-2 print:mt-2 print:gap-1"
    aria-label={`${data.title} 기여 내용`}
  >
    {
      data.contributions.map((contribution: ProjectTask) => (
        <BulletText text={getTaskTitle(contribution)} />
      ))
    }
  </ul>

  {
    data.stack && data.stack.length > 0 && (
      <ul
        class="mt-4 flex flex-wrap gap-2 print:mt-2 print:gap-1.5"
        aria-label={`${data.title} 기술 스택`}
      >
        {data.stack.map((stack: string) => (
          <SkillLabel skill={stack} />
        ))}
      </ul>
    )
  }
</article>
