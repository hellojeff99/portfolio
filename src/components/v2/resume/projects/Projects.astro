---
import { getCollection } from "astro:content";
import {
  compareProjectIds,
  type ProjectEntry,
} from "../../../../content/v2/collections/projects";
import Divider from "../common/Divider.astro";
import SectionLayout from "../common/SectionLayout.astro";
import ProjEntry from "./ProjEntry.astro";

const projEntries: ProjectEntry[] = (await getCollection("v2Projects"))
  .filter((entry) => entry.id.startsWith("project/"))
  .sort((first, second) => {
    const firstIsFeatured = first.id.startsWith("project/featured/");
    const secondIsFeatured = second.id.startsWith("project/featured/");

    if (firstIsFeatured !== secondIsFeatured) {
      return firstIsFeatured ? -1 : 1;
    }

    return compareProjectIds(first.id, second.id);
  });
---

<SectionLayout title="Projects" id="projects" icon="projects">
  <div class="grid">
    {
      projEntries.map((project, index) => (
        <div class="pt-4 first:pt-0 print:break-inside-avoid print:pt-2 print:first:pt-0">
          <ProjEntry {project} />
          {index < projEntries.length - 1 && <Divider />}
        </div>
      ))
    }
  </div>
</SectionLayout>
