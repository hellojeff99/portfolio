---
interface Props {
  skill: string;
  variant?: "default" | "compact";
}

const { skill, variant = "default" } = Astro.props;

const variantClasses = {
  default: "text-xs font-semibold text-slate-600",
  compact: "font-mono text-xs font-semibold tracking-tight text-slate-700",
} satisfies Record<NonNullable<Props["variant"]>, string>;
---

<li
  class:list={[
    "rounded-md bg-slate-200/70 px-2.5 py-1 print:px-2 print:py-0.5",
    variantClasses[variant],
  ]}
>
  {skill}
</li>
