---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<li
  class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-2 text-xs leading-normal font-normal text-slate-700"
>
  <span class="mt-1.5 size-1 rounded-full bg-black" aria-hidden="true"></span>
  <div>
    <span>{text}</span>
  </div>
</li>
