---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<li
  class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-2 text-xs font-normal leading-relaxed text-slate-700 print:leading-normal"
>
  <span
    class="mt-2 size-1.5 rounded-full bg-black print:mt-1.5 print:size-1"
    aria-hidden="true"></span>
  <div>
    <span>{text}</span>
  </div>
</li>
