---
import { getEntry } from "astro:content";
import GradeLabel from "./common/GradeLabel.astro";
import SectionLayout from "./common/SectionLayout.astro";
import TextLabel from "./common/TextLabel.astro";

const resumeEntry = await getEntry("v2Resume", "resume");

if (!resumeEntry) {
  throw new Error(
    "v2 Resume Languages에 필요한 이력서 데이터를 찾을 수 없습니다.",
  );
}

const { languages } = resumeEntry.data;
---

<SectionLayout title="Languages" id="languages" icon="languages">
  <div class="grid gap-4 print:gap-2">
    {
      languages.map((language) => (
        <article class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-x-8 print:break-inside-avoid">
          <div class="min-w-0">
            <div class="flex min-w-0 items-center gap-x-2">
              <h3 class="m-0 truncate text-sm font-semibold tracking-tight text-slate-900 print:text-xs">
                {language.test}
              </h3>
              <GradeLabel grade={language.score} />
            </div>
            <p class="mt-1 flex flex-wrap items-center gap-x-2 text-xs font-medium text-slate-500">
              <span class="text-slate-600">{language.language}</span>
              <span aria-hidden="true" class="font-normal text-slate-300">
                /
              </span>
              <span>{language.issuer}</span>
            </p>
          </div>
          <div class="shrink-0 sm:justify-self-end">
            <TextLabel text={language.date} />
          </div>
        </article>
      ))
    }
  </div>
</SectionLayout>
