---
import InfoField from "./InfoField.astro";

interface Props {
  info: {
    birthDate?: string;
    email: string;
    phone: string;
    location: string;
    links: {
      portfolio: string;
    };
  };
}

const { info } = Astro.props;
---

<dl
  class="mt-8 grid grid-cols-3 gap-x-8 gap-y-4 border-t border-slate-200 pt-3 print:mt-4 print:gap-y-1 print:pt-2"
>
  {
    info.birthDate && (
      <InfoField label="BIRTH" labelKey="birthDate" value={info.birthDate} />
    )
  }
  <InfoField label="EMAIL" labelKey="email" value={info.email} />
  <InfoField
    label="PORTFOLIO"
    labelKey="portfolio"
    value={info.links.portfolio}
  />
  <InfoField
    label="LOCATION"
    labelKey="location"
    value={info.location}
    valueDataAttribute="location"
  />
  <InfoField
    label="PHONE"
    labelKey="phone"
    value={info.phone}
    href={`tel:${info.phone}`}
    valueDataAttribute="phone"
  />
</dl>
