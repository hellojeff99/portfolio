---
import { getEntry } from "astro:content";

const resumeEntry = await getEntry("v2Resume", "resume");

if (!resumeEntry) {
  throw new Error(
    "v2 Resume Treatment에 필요한 이력서 데이터를 찾을 수 없습니다.",
  );
}

const { desiredTreatment } = resumeEntry.data;
const treatments = [
  ["finalSalary", "최종 연봉", desiredTreatment.finalSalary],
  ["desiredSalary", "희망 연봉", desiredTreatment.desiredSalary],
  ["desiredPosition", "희망 직급", desiredTreatment.desiredPosition],
  ["desiredRole", "희망 직무", desiredTreatment.desiredRole],
  ["availableStartDate", "입사 가능일", desiredTreatment.availableStartDate],
] as const;
---

<section
  class="hidden px-16 py-4 print:px-12 print:py-2"
  aria-label="희망 처우"
  data-resume-treatment
>
  <dl
    class="grid grid-cols-2 gap-x-8 gap-y-2 border-t border-slate-200 pt-3 text-xs print:gap-y-1 print:pt-2"
  >
    {
      treatments.map(([key, label, value]) => (
        <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-x-3">
          <dt class="font-bold text-slate-500">{label}</dt>
          <dd
            class="m-0 font-medium text-slate-900"
            data-resume-treatment-value={key}
          >
            {value}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
