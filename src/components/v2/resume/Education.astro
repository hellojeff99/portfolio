---
import { getEntry } from "astro:content";
import EntryMainText from "./common/EntryMainText.astro";
import EntrySubText from "./common/EntrySubText.astro";
import GradeLabel from "./common/GradeLabel.astro";
import SectionLayout from "./common/section/SectionLayout.astro";
import TextLabel from "./common/TextLabel.astro";

const resumeEntry = await getEntry("v2Resume", "resume");

if (!resumeEntry) {
throw new Error(
  "v2 Resume Education에 필요한 이력서 데이터를 찾을 수 없습니다.",
);
}

const { educations } = resumeEntry.data;
---
<SectionLayout title="Education" id="education">
  {
    educations.map((education) => (
      <article class="grid break-inside-avoid grid-cols-4 items-start gap-x-4 py-1 first:pt-0 last:pb-0">
        <div class="col-span-2 flex min-w-0 items-start gap-x-2">
          <EntryMainText text={education.school} />
        </div>
        <div class="grid justify-self-start">
          <div class="flex min-w-0 items-start gap-x-2">
            {education.major && <EntryMainText text={education.major} />}
            {education.gpa && <GradeLabel grade={education.gpa} />}
          </div>
          {education.sub && <EntrySubText text={education.sub} />}
        </div>
        <div class="justify-self-end">
          <TextLabel text={education.period} />
        </div>
      </article>
    ))
  }
</SectionLayout>
