---
import { ArrowUpRight, Mail } from "@lucide/astro";
import { siGithub } from "simple-icons";

const email = "ysw991106@gmail.com";
const githubUrl = "https://github.com/hellojeff99";
---

<footer
  id="contact"
  class="border-t border-base-300 bg-base-100 px-5 py-10 sm:px-8 lg:px-12 lg:py-12"
  aria-label="연락처"
>
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 sm:flex-row sm:items-end sm:justify-between"
  >
    <div class="space-y-2">
      <p class="text-sm font-medium tracking-tight text-base-content/60">
        CONTACT
      </p>
      <a
        class="group inline-flex items-center gap-2 text-xl font-semibold tracking-tight text-base-content transition-colors hover:text-sky-700 sm:text-2xl"
        href={`mailto:${email}`}
      >
        {email}
        <ArrowUpRight
          class="size-5 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transform-none"
          aria-hidden="true"
        />
      </a>
    </div>

    <div
      class="flex items-center gap-5 text-sm font-medium text-base-content/60"
    >
      <a
        class="inline-flex items-center gap-2 transition-colors hover:text-base-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-700 focus-visible:ring-offset-2"
        href={githubUrl}
        target="_blank"
        rel="noreferrer"
      >
        <svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d={siGithub.path}></path>
        </svg>
        GitHub
      </a>
      <a
        class="inline-flex items-center gap-2 transition-colors hover:text-base-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-700 focus-visible:ring-offset-2"
        href={`mailto:${email}`}
      >
        <Mail class="size-4" aria-hidden="true" />
        Email
      </a>
      <a
        class="transition-colors hover:text-base-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-700 focus-visible:ring-offset-2"
        href="#top"
      >
        Top
      </a>
    </div>
  </div>

  <div class="mx-auto mt-10 max-w-6xl border-t border-base-300 pt-4">
    <p class="text-xs text-base-content/40">
      © {new Date().getFullYear()} Yang Seongwon
    </p>
  </div>
</footer>
