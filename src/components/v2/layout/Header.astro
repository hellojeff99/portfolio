---
import { ArrowUpRight, FileText, Menu, X } from "@lucide/astro";

const navigationItems = [
  { label: "About", href: "#about" },
  { label: "Skills", href: "#skills" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="group/header fixed inset-x-0 top-0 z-50 border-b border-transparent bg-transparent shadow-none transition-[background-color,border-color,box-shadow] duration-300 ease-out data-[scrolled=true]:border-slate-200 data-[scrolled=true]:bg-white data-[scrolled=true]:shadow-sm motion-reduce:transition-none"
  data-v2-header
  data-scrolled="false"
>
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8 lg:px-12"
  >
    <a
      class="group/brand inline-flex min-w-0 items-center gap-3 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-2 group-data-[scrolled=true]/header:focus-visible:ring-sky-600"
      href="#top"
      aria-label="Yang Seongwon 포트폴리오 최상단으로 이동"
    >
      <span
        class="grid size-8 shrink-0 place-items-center rounded-full bg-white font-mono text-xs font-bold tracking-tighter text-slate-950 transition duration-300 ease-out group-hover/brand:-rotate-6 group-data-[scrolled=true]/header:bg-slate-950 group-data-[scrolled=true]/header:text-white motion-reduce:transition-none"
        aria-hidden="true"
      >
        YS
      </span>
      <span class="flex min-w-0 flex-col leading-none">
        <span
          class="truncate text-sm font-bold tracking-tight text-white transition-colors duration-300 ease-out group-data-[scrolled=true]/header:text-slate-950 motion-reduce:transition-none"
        >
          YANG SEONGWON
        </span>
        <span
          class="mt-1 font-mono text-[0.62rem] font-semibold tracking-[0.14em] text-sky-200 transition-colors duration-300 ease-out group-data-[scrolled=true]/header:text-slate-500 motion-reduce:transition-none"
        >
          PORTFOLIO / 2026
        </span>
      </span>
    </a>

    <div class="ml-auto flex items-center gap-3">
      <nav class="hidden items-center gap-1 lg:flex" aria-label="주요 메뉴">
        {
          navigationItems.map(({ label, href }) => (
            <a
              class="rounded-md px-3 py-2 text-sm font-semibold text-white transition-colors duration-300 ease-out hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-2 group-data-[scrolled=true]/header:text-slate-700 group-data-[scrolled=true]/header:hover:bg-slate-100 group-data-[scrolled=true]/header:hover:text-slate-950 group-data-[scrolled=true]/header:focus-visible:ring-sky-600 motion-reduce:transition-none"
              href={href}
            >
              {label}
            </a>
          ))
        }
      </nav>

      <a
        class="hidden items-center gap-2 rounded-full border border-white/40 px-4 py-2 text-sm font-bold text-white transition-colors duration-300 ease-out hover:border-white hover:bg-white hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-2 group-data-[scrolled=true]/header:border-slate-300 group-data-[scrolled=true]/header:text-slate-950 group-data-[scrolled=true]/header:hover:border-slate-950 group-data-[scrolled=true]/header:hover:bg-slate-950 group-data-[scrolled=true]/header:hover:text-white group-data-[scrolled=true]/header:focus-visible:ring-sky-600 motion-reduce:transition-none sm:inline-flex"
        href="/resume"
      >
        <FileText class="size-4" stroke-width={2} aria-hidden="true" />
        Resume
      </a>

      <details class="group/menu relative lg:hidden">
        <summary
          class="grid size-10 cursor-pointer place-items-center rounded-full border border-white/40 text-white transition-colors duration-300 ease-out hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-2 group-data-[scrolled=true]/header:border-slate-300 group-data-[scrolled=true]/header:text-slate-950 group-data-[scrolled=true]/header:hover:bg-slate-100 group-data-[scrolled=true]/header:focus-visible:ring-sky-600 motion-reduce:transition-none [&::-webkit-details-marker]:hidden"
          aria-label="메뉴 열기"
        >
          <Menu
            class="size-5 group-open/menu:hidden"
            stroke-width={2}
            aria-hidden="true"
          />
          <X
            class="hidden size-5 group-open/menu:block"
            stroke-width={2}
            aria-hidden="true"
          />
        </summary>
        <nav
          class="absolute right-0 top-[calc(100%+0.75rem)] w-56 rounded-2xl border border-base-300 bg-base-100 p-2 shadow-xl shadow-base-content/10"
          aria-label="모바일 메뉴"
        >
          {
            navigationItems.map(({ label, href }) => (
              <a
                class="flex items-center justify-between rounded-xl px-4 py-3 text-sm font-semibold text-base-content/80 transition-colors hover:bg-base-200 hover:text-base-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-700 focus-visible:ring-inset"
                href={href}
              >
                {label}
                <ArrowUpRight
                  class="size-4 text-base-content/35"
                  aria-hidden="true"
                />
              </a>
            ))
          }
          <a
            class="mt-1 flex items-center justify-between rounded-xl border border-base-300 px-4 py-3 text-sm font-bold text-base-content transition-colors hover:border-base-content hover:bg-base-content hover:text-base-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-700 focus-visible:ring-inset"
            href="/resume"
          >
            <span class="inline-flex items-center gap-2">
              <FileText class="size-4" stroke-width={2} aria-hidden="true" />
              Resume
            </span>
            <ArrowUpRight class="size-4" aria-hidden="true" />
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const initializeV2Header = () => {
    const header = document.querySelector<HTMLElement>("[data-v2-header]");
    if (!header) return;

    const updateHeader = () => {
      header.dataset.scrolled = String(window.scrollY > 8);
    };

    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });
  };

  initializeV2Header();
  document.addEventListener("astro:page-load", initializeV2Header);
</script>
