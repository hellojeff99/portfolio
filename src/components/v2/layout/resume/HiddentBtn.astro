---
import TreatmentPrintModal from "./TreatmentPrintModal.astro";

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<button
  class="cursor-default text-xs text-white/35 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-4 focus-visible:ring-offset-slate-950 disabled:opacity-35"
  type="button"
  data-hidden-resume-print
  aria-label="이력서 인쇄"
>
  © {new Date().getFullYear()}
  {name}
</button>

<TreatmentPrintModal />

<script>
  type TreatmentValues = Record<string, string>;
  interface TreatmentPrintInput {
    phone: string;
    treatmentValues: TreatmentValues;
  }
  interface TreatmentPrintRequest {
    includeTreatment: boolean;
    phone: string;
    treatmentValues: TreatmentValues;
    useKoreanSectionTitles: boolean;
  }

  const hiddenPrintButton = document.querySelector<HTMLButtonElement>(
    "[data-hidden-resume-print]",
  );
  const treatment = document.querySelector<HTMLElement>(
    "[data-resume-treatment]",
  );
  const phone = document.querySelector<HTMLAnchorElement>(
    "[data-resume-phone]",
  );
  const sectionTitles = document.querySelectorAll<HTMLElement>(
    "[data-resume-section-title]",
  );
  const infoLabels = document.querySelectorAll<HTMLElement>(
    "[data-resume-info-label]",
  );
  const koreanSectionTitles: Record<string, string> = {
    about: "소개",
    education: "학력",
    certifications: "자격증",
    languages: "어학",
    career: "경력",
    projects: "프로젝트",
    activities: "활동",
  };
  const koreanInfoLabels: Record<string, string> = {
    birthDate: "생년월일",
    email: "이메일",
    phone: "휴대폰",
    location: "거주지",
  };

  const getTreatmentValues = (): TreatmentValues => {
    return Object.fromEntries(
      Array.from(
        document.querySelectorAll<HTMLElement>("[data-resume-treatment-value]"),
        (value) => [
          value.dataset.resumeTreatmentValue ?? "",
          value.textContent?.trim() ?? "",
        ],
      ),
    );
  };

  const applyTreatmentValues = (treatmentValues: TreatmentValues) => {
    Object.entries(treatmentValues).forEach(([key, inputValue]) => {
      const value = document.querySelector<HTMLElement>(
        `[data-resume-treatment-value="${key}"]`,
      );
      if (value) value.textContent = inputValue;
    });
  };

  const applyPhone = (phoneNumber: string) => {
    if (!phone) return;

    phone.textContent = phoneNumber;
    phone.href = `tel:${phoneNumber}`;
  };

  const applySectionTitleLanguage = (useKorean: boolean) => {
    sectionTitles.forEach((sectionTitle) => {
      const id = sectionTitle.dataset.resumeSectionTitle ?? "";
      const defaultTitle =
        sectionTitle.dataset.resumeSectionTitleDefault ??
        sectionTitle.textContent;

      sectionTitle.textContent = useKorean
        ? (koreanSectionTitles[id] ?? defaultTitle)
        : defaultTitle;
    });
  };

  const applyInfoLabelLanguage = (useKorean: boolean) => {
    infoLabels.forEach((infoLabel) => {
      const id = infoLabel.dataset.resumeInfoLabel ?? "";
      const defaultLabel =
        infoLabel.dataset.resumeInfoLabelDefault ?? infoLabel.textContent;

      infoLabel.textContent = useKorean
        ? (koreanInfoLabels[id] ?? defaultLabel)
        : defaultLabel;
    });
  };

  const printResume = async (
    includeTreatment: boolean,
    useKoreanSectionTitles: boolean,
  ) => {
    if (!hiddenPrintButton) return;

    hiddenPrintButton.disabled = true;
    hiddenPrintButton.setAttribute("aria-busy", "true");
    treatment?.classList.toggle("print:block", includeTreatment);
    applySectionTitleLanguage(useKoreanSectionTitles);
    applyInfoLabelLanguage(useKoreanSectionTitles);

    try {
      await document.fonts.ready;
      await Promise.all(
        Array.from(document.images, (image) =>
          image.complete ? Promise.resolve() : image.decode().catch(() => {}),
        ),
      );
      window.print();
    } finally {
      treatment?.classList.remove("print:block");
      applySectionTitleLanguage(false);
      applyInfoLabelLanguage(false);
      hiddenPrintButton.disabled = false;
      hiddenPrintButton.removeAttribute("aria-busy");
    }
  };

  hiddenPrintButton?.addEventListener("click", () => {
    document.dispatchEvent(
      new CustomEvent<TreatmentPrintInput>("resume-treatment-print:open", {
        detail: {
          phone: phone?.textContent?.trim() ?? "",
          treatmentValues: getTreatmentValues(),
        },
      }),
    );
  });

  document.addEventListener("resume-treatment-print:submit", (event) => {
    const {
      includeTreatment,
      phone: phoneNumber,
      treatmentValues,
      useKoreanSectionTitles,
    } = (event as CustomEvent<TreatmentPrintRequest>).detail;

    applyPhone(phoneNumber);
    if (includeTreatment) applyTreatmentValues(treatmentValues);
    void printResume(includeTreatment, useKoreanSectionTitles);
  });
</script>
