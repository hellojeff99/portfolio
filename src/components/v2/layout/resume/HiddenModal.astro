<dialog
  class="m-auto max-h-[calc(100dvh-var(--spacing-8))] w-[calc(100dvw-var(--spacing-8))] max-w-xl overflow-y-auto rounded-3xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60"
  aria-labelledby="treatment-print-modal-title"
  data-treatment-print-modal
>
  <form class="overflow-hidden" data-treatment-print-form>
    <header class="border-b border-slate-200 bg-slate-50 px-6 py-5 sm:px-8">
      <p class="text-xs font-bold tracking-[0.18em] text-sky-700">
        PRINT SETTINGS
      </p>
      <h2
        id="treatment-print-modal-title"
        class="mt-2 text-2xl font-bold tracking-tight text-slate-950"
      >
        인쇄 설정
      </h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">
        연락처와 출력 방식을 선택한 뒤, 필요한 정보를 입력해 주세요.
      </p>
    </header>

    <div class="space-y-5 px-6 py-6 sm:px-8">
      <label class="grid gap-1.5 text-sm font-semibold text-slate-700">
        휴대폰 번호
        <input
          class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-base font-medium text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          data-resume-phone-input
        />
      </label>

      <label class="grid gap-1.5 text-sm font-semibold text-slate-700">
        직무
        <input
          class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-base font-medium text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
          name="role"
          type="text"
          autocomplete="organization-title"
          data-resume-role-input
        />
      </label>

      <fieldset class="grid grid-cols-2 gap-3">
        <legend class="col-span-2 mb-1 text-sm font-bold text-slate-950">
          인쇄 옵션
        </legend>
        <label
          class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm font-semibold text-slate-800 shadow-sm transition-colors hover:border-slate-300 [&:has(input:checked)]:border-sky-600 [&:has(input:checked)]:bg-sky-50"
        >
          <input
            class="size-4 shrink-0 rounded border-slate-300 accent-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2"
            type="checkbox"
            checked
            data-treatment-print-include
          />
          <span class="grid gap-0.5">
            처우 정보 포함
            <span class="text-xs font-medium text-slate-500">
              연봉, 직급, 직무, 입사 가능일을 함께 출력합니다.
            </span>
          </span>
        </label>

        <label
          class="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm font-semibold text-slate-800 shadow-sm transition-colors hover:border-slate-300 [&:has(input:checked)]:border-sky-600 [&:has(input:checked)]:bg-sky-50"
        >
          <input
            class="size-4 shrink-0 rounded border-slate-300 accent-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2"
            type="checkbox"
            data-section-title-korean
          />
          <span class="grid gap-0.5">
            섹션 제목 한글로 출력
            <span class="text-xs font-medium text-slate-500">
              인적사항 제목까지 한글로 출력합니다.
            </span>
          </span>
        </label>
      </fieldset>

      <fieldset
        class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4"
        data-treatment-input-fields
      >
        <legend class="px-1 text-sm font-bold text-slate-950">처우 정보</legend>
        <div class="mt-3 grid gap-4">
          <label class="grid gap-1.5 text-sm font-semibold text-slate-700">
            최종 연봉
            <input
              class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-base font-medium text-slate-900 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
              name="finalSalary"
              type="text"
              data-treatment-input
            />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-slate-700">
            희망 연봉
            <input
              class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-base font-medium text-slate-900 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
              name="desiredSalary"
              type="text"
              data-treatment-input
            />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-slate-700">
            희망 직급
            <input
              class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-base font-medium text-slate-900 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
              name="desiredPosition"
              type="text"
              data-treatment-input
            />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-slate-700">
            입사 가능일
            <input
              class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-base font-medium text-slate-900 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
              name="availableStartDate"
              type="text"
              data-treatment-input
            />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-slate-700">
            희망 직무
            <input
              class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-base font-medium text-slate-900 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
              name="desiredRole"
              type="text"
              data-treatment-input
            />
          </label>
        </div>
      </fieldset>
    </div>

    <div
      class="flex flex-col-reverse gap-3 border-t border-slate-200 bg-white px-6 py-4 sm:flex-row sm:justify-end sm:px-8"
    >
      <button
        class="inline-flex justify-center rounded-xl px-4 py-2.5 text-sm font-bold text-slate-600 transition-colors hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2"
        type="button"
        data-treatment-print-cancel
      >
        취소
      </button>
      <button
        class="inline-flex justify-center rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2"
        type="submit"
      >
        인쇄
      </button>
    </div>
  </form>
</dialog>

<script>
  type TreatmentValues = Record<string, string>;
  interface TreatmentPrintInput {
    phone: string;
    role: string;
    treatmentValues: TreatmentValues;
  }
  interface TreatmentPrintRequest {
    includeTreatment: boolean;
    phone: string;
    role: string;
    treatmentValues: TreatmentValues;
    useKoreanSectionTitles: boolean;
  }

  const treatmentPrintModal = document.querySelector<HTMLDialogElement>(
    "[data-treatment-print-modal]",
  );
  const treatmentPrintForm = document.querySelector<HTMLFormElement>(
    "[data-treatment-print-form]",
  );
  const treatmentInputs = document.querySelectorAll<HTMLInputElement>(
    "[data-treatment-input]",
  );
  const treatmentPrintInclude = document.querySelector<HTMLInputElement>(
    "[data-treatment-print-include]",
  );
  const phoneInput = document.querySelector<HTMLInputElement>(
    "[data-resume-phone-input]",
  );
  const roleInput = document.querySelector<HTMLInputElement>(
    "[data-resume-role-input]",
  );
  const sectionTitleKoreanInput = document.querySelector<HTMLInputElement>(
    "[data-section-title-korean]",
  );
  const treatmentInputFields = document.querySelector<HTMLElement>(
    "[data-treatment-input-fields]",
  );

  const toggleTreatmentInputs = (includeTreatment: boolean) => {
    treatmentInputFields?.toggleAttribute("hidden", !includeTreatment);
  };

  document.addEventListener("resume-treatment-print:open", (event) => {
    const { phone, role, treatmentValues } = (
      event as CustomEvent<TreatmentPrintInput>
    ).detail;

    treatmentInputs.forEach((input) => {
      input.value = treatmentValues[input.name] ?? "";
    });
    if (phoneInput) phoneInput.value = phone;
    if (roleInput) roleInput.value = role;
    if (treatmentPrintInclude) treatmentPrintInclude.checked = true;
    if (sectionTitleKoreanInput) sectionTitleKoreanInput.checked = false;
    toggleTreatmentInputs(true);
    treatmentPrintModal?.showModal();
    requestAnimationFrame(() => treatmentInputs[0]?.focus());
  });

  treatmentPrintForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    const treatmentValues = Object.fromEntries(
      Array.from(treatmentInputs, (input) => [input.name, input.value.trim()]),
    );
    treatmentPrintModal?.close();
    document.dispatchEvent(
      new CustomEvent<TreatmentPrintRequest>("resume-treatment-print:submit", {
        detail: {
          includeTreatment: treatmentPrintInclude?.checked ?? true,
          phone: phoneInput?.value.trim() ?? "",
          role: roleInput?.value.trim() ?? "",
          treatmentValues,
          useKoreanSectionTitles: sectionTitleKoreanInput?.checked ?? false,
        },
      }),
    );
  });

  treatmentPrintInclude?.addEventListener("change", () => {
    toggleTreatmentInputs(treatmentPrintInclude.checked);
  });

  document
    .querySelector<HTMLButtonElement>("[data-treatment-print-cancel]")
    ?.addEventListener("click", () => treatmentPrintModal?.close());

  treatmentPrintModal?.addEventListener("click", (event) => {
    if (event.target === treatmentPrintModal) treatmentPrintModal.close();
  });
</script>
