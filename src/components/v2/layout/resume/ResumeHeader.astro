---
import { Code2, FileText, Printer } from "@lucide/astro";
---

<header
  class="group/header fixed inset-x-0 top-0 z-50 border-b border-slate-200 bg-white font-sans shadow-sm print:hidden"
>
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8 lg:px-12"
  >
    <a
      class="group/brand inline-flex min-w-0 items-center gap-3 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2"
      href="/v2/resume"
      aria-label="Jeffrey's resume 최상단으로 이동"
    >
      <span
        class="grid size-8 shrink-0 place-items-center rounded-full bg-slate-950 text-sm font-bold tracking-tighter text-white transition duration-300 ease-out group-hover/brand:-rotate-6 motion-reduce:transition-none"
        aria-hidden="true"
      >
        <FileText class="size-4" stroke-width={2.4} aria-hidden="true" />
      </span>
      <span class="truncate text-lg font-bold tracking-tight text-slate-950">
        JEFFREY'S RESUME
      </span>
    </a>

    <div class="ml-auto flex items-center gap-3">
      <button
        class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-4 py-2 text-base font-bold text-slate-950 transition-colors duration-300 ease-out hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-60 motion-reduce:transition-none"
        type="button"
        data-resume-print
        aria-label="이력서 인쇄"
      >
        <Printer class="size-4" stroke-width={2} aria-hidden="true" />
        PRINT
      </button>

      <a
        class="hidden items-center gap-2 rounded-full border border-slate-950 bg-slate-950 px-4 py-2 text-base font-bold text-white transition-colors duration-300 ease-out hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 motion-reduce:transition-none sm:inline-flex"
        href="/v2"
      >
        <Code2 class="size-4" stroke-width={2} aria-hidden="true" />
        PORTFOLIO
      </a>
    </div>
  </div>
</header>

<script>
  const printButton = document.querySelector<HTMLButtonElement>(
    "[data-resume-print]",
  );

  printButton?.addEventListener("click", async () => {
    printButton.disabled = true;
    printButton.setAttribute("aria-busy", "true");

    try {
      await document.fonts.ready;
      await Promise.all(
        Array.from(document.images, (image) =>
          image.complete ? Promise.resolve() : image.decode().catch(() => {}),
        ),
      );
      window.print();
    } finally {
      printButton.disabled = false;
      printButton.removeAttribute("aria-busy");
    }
  });
</script>
